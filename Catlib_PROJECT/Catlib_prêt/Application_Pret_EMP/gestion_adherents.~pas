procedure TForm_gestion_adherents.Button_detail_adherentClick(Sender: TObject);
begin
if (id_adherent.Text <> '') then
        begin
                //-------- Verifier est ce que cet adherent existe
                Query1.SQL.Text := 'select count(*) from adherent where upper(id_adherent) = ''' + strupper(Pchar(id_adherent.Text)) + '''' ;
                Query1.ExecSQL ; Query1.Active := true ; Query1.First ;

                if (Query1.Fields.FieldByNumber(1).AsInteger = 1 ) then   //--- c'est à dire que l'adhérent existe
                        begin
                                form_pret.date_pret.Text := datetostr(date) ;
                                form_pret.id_adherent.Text := id_adherent.Text ;
                                form_pret.Button_detail.Click;
                        end
                else    Showmessage('Cet Adhérent n''existe pas dans la base, veuillez vérifier!!!') ;
        end
else
        begin
                Showmessage('Veuillez saisir un ID Adhérent !!!') ;
        end;

end;


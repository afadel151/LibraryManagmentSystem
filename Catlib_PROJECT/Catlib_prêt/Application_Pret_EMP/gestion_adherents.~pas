procedure TForm_gestion_adherents.Button1_searchClick(Sender: TObject);

begin
type_recherche := 1 ;

//------- Initialisation

        nom_adherent.Text := '' ;
        Edit_id_adherent.Text := '' ;
        Edit_nom_adherent.Text := '' ;
        Edit_prenom_adherent.Text := '' ;
        Edit_id_position_adherent.Text := '' ;
        Edit_categorie_adherent.Text := '' ;
        Edit_etat_adherent.Text := '' ;
        Edit_libelle_position.Text := '' ;
        Edit_libelle_categorie.Text := '' ;
        Edit_desc_etat_adherent.Text := '' ;

Query_recherche_adherent.SQL.Text := 'select * from adherent where upper(id_adherent) = ''' + strupper(Pchar(id_adherent.Text)) + '''' ;
Query_recherche_adherent.ExecSQL;
Query_recherche_adherent.Active := true ;
Query_recherche_adherent.First;

while not Query_recherche_adherent.eof do
     begin
        Edit_id_adherent.Text := DBEdit_id_adherent.Text ;
        Edit_nom_adherent.Text := DBEdit_nom_adherent.Text ;
        Edit_prenom_adherent.Text := DBEdit_prenom_adherent.Text ;
        Edit_id_position_adherent.Text := DBEdit_id_position_adherent.Text ;
        Edit_categorie_adherent.Text := DBEdit_categorie_adherent.Text ;
        Edit_etat_adherent.Text := DBEdit_etat_adherent.Text ;

        //-------- Extraire libelle position

        Query1.SQL.Text := 'select libelle_position from position where upper(id_position) = ''' + strupper(Pchar(Edit_id_position_adherent.Text)) + '''' ;
        Query1.ExecSQL; Query1.Active := true ; Query1.First;
        Edit_libelle_position.Text := Query1.Fields.FieldByNumber(1).AsString ;

        //-------- Extraire la catégorie

        Query1.SQL.Text := 'select LIBELLE_CATEGORIE from CATEGORIE where upper(id_categorie) = ''' + strupper(Pchar(Edit_categorie_adherent.Text)) + '''' ;
        Query1.ExecSQL; Query1.Active := true ; Query1.First;
        Edit_libelle_categorie.Text := Query1.Fields.FieldByNumber(1).AsString ;

        //-------- Extraire l'état de l'adhérent

        Query1.SQL.Text := 'select DESC_ETAT from etat_adherent where id_etat = ''' + Edit_etat_adherent.Text + '''' ;
        Query1.ExecSQL; Query1.Active := true ; Query1.First;
        Edit_desc_etat_adherent.Text := Query1.Fields.FieldByNumber(1).AsString ;

        //------- affichage de la photo ---------------

        nom_photo := DBEdit_id_adherent.Text ;
        nom_photo[Pos('/', nom_photo)] := '-'; // ----------remplacer le caractere / dans le num adherent par - pour traieter son fichier image

        Image1 := TJPEGImage.Create;

        if ( FileExists ('\\library-server\photos_adherents\'+ nom_photo +'.JPG') ) then
                begin
                Image1.LoadFromFile('\\library-server\photos_adherents\'+ nom_photo +'.JPG') ;
                Image_adherent.Picture.Graphic := Image1 ;
                Image_adherent.Visible := True;
                end
        else
                begin
                Image1.Destroy ; Image1 := TJPEGImage.Create;
                Image_adherent.Visible := False;
                end;
         Query_recherche_adherent.Next ;
     end;


 if ( DBEdit_id_adherent.Text = '' ) then Edit_id_adherent.Enabled := True ;


end;


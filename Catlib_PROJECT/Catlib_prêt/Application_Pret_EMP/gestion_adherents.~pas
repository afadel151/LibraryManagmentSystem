procedure TForm_gestion_adherents.Button_valider_modificationClick(
  Sender: TObject);
var
Chaine_Inter1, Chaine_Inter2 : String ;
i, j : Integer ;

begin

//---- Mettre à jours les infomations dans la base
if MessageDlg('Voulez vous vraiment valider les modifications ?', mtConfirmation, [mbyes, mbNo], 0) = mrYes then
   begin
        if (Edit_id_adherent.Text <> '') then
                begin
                        //--------------------------------------------------------------------------------
                        //------- Traiter le nom et prenom pour eviter le probleme des apostrophes
                        //--------------------------------------------------------------------------------

                        Query1.SQL.Text := 'update adherent set nom =''' + Edit_nom_adherent.Text
                                + ''', prenom = '''        + Edit_prenom_adherent.Text
                                + ''', id_position  = '''  + Edit_id_position_adherent.Text
                                + ''', id_categorie = '''  + Edit_categorie_adherent.Text
                                + ''', etat_adherent= '''  + Edit_etat_adherent.Text
                                + ''' where upper(id_adherent) = ''' + strupper(Pchar(DBEdit_id_adherent.Text)) + '''' ;
                        Query1.ExecSQL;
                end
        else
                begin
                     Showmessage('Il faut choisir l''adhérent avant (par Recherche)!!!!');
                end;
   end;
end;

procedure TForm_gestion_adherents.Button_supprimer_adherentClick(
  Sender: TObject);
begin


if MessageDlg('Voulez vous vraiment Supprimer cet Adhérent ?', mtConfirmation, [mbYes, mbNo], 0) = mrYes then
   begin
        if (DBEdit_id_adherent.Text <> '') then
                begin

                        Query1.SQL.Text := 'select count(*) from pret where upper(id_adherent) = ''' + strupper(Pchar(DBEdit_id_adherent.Text)) + '''' ;
                        Query1.ExecSQL;Query1.Active := true ; Query1.First;

                        if (Query1.Fields.FieldByNumber(1).AsInteger > 0) then
                                begin
                                     Showmessage('Cet Adhérent Possède des Prêt en cours. Suppression Impossible !!!');
                                end
                        else
                                begin
                                        //------------- Cette requete doit etre modifiée 
                                        Query1.SQL.Text := 'delete  from adherent cascade where upper(id_adherent) = ''' + strupper(Pchar(DBEdit_id_adherent.Text)) + '''' ;
                                        Query1.ExecSQL;
                                end;
                        //--------- Remetre le tous à vide
                        FormShow(nil);
                end
        else
                begin
                     Showmessage('Il faut choisir l''adhérent avant (par Recherche)!!!!');
                end;
   end;


end;

procedure TForm_gestion_adherents.Button_ajouter_adherentClick(
  Sender: TObject);
begin

if MessageDlg('Voulez vous vraiment Ajouter cet adhérent ?', mtConfirmation, [mbOK, mbCancel], 0) = mrOK then
   begin
        if ((Edit_id_adherent.Text <> '') and (Edit_nom_adherent.Text <> '') and ( Edit_prenom_adherent.Text <> '') and (Edit_id_position_adherent.Text <> '') and (Edit_categorie_adherent.Text <> '') ) then
                begin

                        //--------------------------------------------------------------------------------
                        //------- Traiter le nom et prenom pour eviter le probleme des apostrophes
                        //--------------------------------------------------------------------------------
                        Query1.active := false ;
                        Query1.SQL.Text := 'select count(*) from adherent where upper(id_adherent) = ''' + strupper(Pchar(Edit_id_adherent.Text)) + '''' ;
                        Query1.ExecSQL;
                        Query1.active := True ;
                        if ( Query1.Fields.FieldByNumber(1).AsInteger < 1 ) then //---- C'est à dire qu'il n ya aucun adherent avec ce code
                                begin
                                                Query1.SQL.Text := 'insert into adherent values(''' + strupper(Pchar(Edit_id_adherent.Text))
                                                + ''','''   + Edit_nom_adherent.Text
                                                + ''','''   + Edit_prenom_adherent.Text
                                                + ''','''   + Edit_id_position_adherent.Text
                                                + ''','''   + Edit_categorie_adherent.Text
                                                + ''',''1'')' ;
                                                Showmessage(Query1.SQL.Text) ;
                                                Query1.ExecSQL;
                                                FormShow(nil);
                                end
                        else
                                Showmessage('Ce code Adhrérent existe déjà !!!') ;
                end
        else
                begin
                     Showmessage('Il faut Remplir toutes kles informations !!!');
                end;
   end;

end;


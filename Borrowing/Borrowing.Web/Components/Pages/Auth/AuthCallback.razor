@page "/auth-callback"
@using Borrowing.Web.Providers
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject NavigationManager Nav
@inject JwtAuthStateProvider AuthStateProvider

<div style="display:flex;justify-content:center;align-items:center;height:100vh">
    <p>Authentification en cours...</p>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Cookie was set by WebAPI redirect — just notify Blazor auth state changed
        AuthStateProvider.NotifyAuthStateChanged();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var role = authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
            Nav.NavigateTo(role == "ADMIN" ? "/admin" : "/", forceLoad: true);
        }
        else
        {
            Nav.NavigateTo("/Login?error=Authentification+échouée", forceLoad: true);
        }
    }
}
@page "/Login"
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject AuthService AuthService
@inject NavigationManager Nav

<div style="display:flex; justify-content:center; align-items:center; height:100vh; background:#f0f2f5;">
    <div style="background:white; padding:2rem; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,0.1); width:320px;">
        <h3 style="text-align:center; margin-top:0;">CATlib-PRET</h3>
        <p style="text-align:center; color:#666;">Entrez votre identifiant pour continuer</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger">@error</div>
        }

        <div style="margin-bottom:1rem;">
            <label>Compte utilisateur</label>
            <input class="form-control" @bind="compte" placeholder="ex: alice" />
        </div>

        <button class="btn btn-primary w-100" @onclick="HandleLogin" disabled="@isLoading">
            @(isLoading ? "Redirection..." : "Continuer")
        </button>
    </div>
</div>

@code {
    string compte;
    string error;
    bool isLoading;

    [Parameter, SupplyParameterFromQuery] public string Error { get; set; }

    protected override void OnInitialized() => error = Error;

    async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(compte))
        {
            error = "Veuillez entrer votre identifiant.";
            return;
        }

        isLoading = true;
        error     = null;

        await AuthService.StartLoginAsync(compte);

        // If we reach here, StartLoginAsync failed to redirect
        error     = "Impossible de contacter le serveur d'authentification.";
        isLoading = false;
    }
}
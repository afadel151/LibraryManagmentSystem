@page "/prets"
@using Borrowing.SharedClasses.Requests.Reservation
@using Borrowing.SharedClasses.Responses.Reservation
@using Borrowing.Web.Components.Base
@using Borrowing.Web.Services
@using Borrowing.SharedClasses.Responses.Pret
@using Borrowing.SharedClasses.Models
@using Borrowing.SharedClasses.Requests.Pret

@inject IPretService pretService
@using Borrowing.SharedClasses.Responses.Adherent
@using Borrowing.SharedClasses.Responses.Notice
@using Microsoft.Extensions.Localization
@using Radzen
@using Radzen.Blazor
@using Common.Models

@inject NotificationService NotificationService

@inherits AuthorizedComponentBase
@inject IStringLocalizer<Prets> L
<RadzenRow class="rz-text-align-center " Gap="1rem">
    <RadzenColumn>
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.H5">@L["CurrentLoans"]</RadzenText> @*CurrentLoans*@
                    <RadzenText TextStyle="TextStyle.H2" class="rz-color-success rz-m-0">
                        @(stats?.Prets ?? 0)
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn>
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.H5">@L["LateLoans"]</RadzenText> @*LateLoans*@
                    <RadzenText TextStyle="TextStyle.H2" class="rz-color-info rz-m-0">
                        @(stats?.Retard ?? 0)
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn>
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.H5">@L["Reservations"]</RadzenText>
                    <RadzenText TextStyle="TextStyle.H2" class="rz-color-warning rz-m-0">
                        @(stats?.Reservations ?? 0)
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenText TextStyle="TextStyle.H3" class="rz-mt-8">@L["InsertLoan"]</RadzenText> @**@

<RadzenRow class="rz-mt-4">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenText TextStyle="TextStyle.H5">@L["MemberInformations"]</RadzenText> @**@

            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" class="rz-mt-3"> @**@
                <RadzenTextBox Placeholder="@L["InsertMemberId"]" @bind-Value="AdherentId" @oninput="OnMemberTyping"
                               Change="OnMemberIdChanged" class="w-100" />

                @if (isLoadingMember)
                {
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                }
                else if (hasSearchedMember && adherentCheck != null)
                {
                    @if (adherentCheck.Etat == CheckAdherentEnum.NOT_FOUND)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" class="rz-color-danger">@L["MembreNotFound"] .</RadzenText>
                    }
                    else
                    {
                        <RadzenRow>
                            <RadzenColumn Size="4">
                                <img src="@(adherentCheck.picture)" style="width: 100%; border-radius: 8px;"
                                     onerror="this.style.display='none'" />
                            </RadzenColumn>
                            <RadzenColumn Size="8">
                                <RadzenText TextStyle="TextStyle.Subtitle1"><b>@(adherentCheck.Adherent?.Nom?.ToUpper())
                                    @adherentCheck.Adherent?.Prenom</b></RadzenText>
                                    <RadzenText TextStyle="TextStyle.Body2">@L["Category"]: 
                                        @adherentCheck.Adherent?.Categorie?.LibelleCategorie
                                    </RadzenText>
                                    
                                    @switch (adherentCheck.Etat)
                                    {
                                        case CheckAdherentEnum.AUTHORIZED:
                                            <div class="rz-mt-2">
                                                <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="@L["ActifMember"]" class="rz-mb-2" />
                                                <RadzenText TextStyle="TextStyle.Body2">@L["Quota"]: @adherentCheck.ActiveLoans /
                                                    @adherentCheck.Adherent?.Categorie?.NombreDocument</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-success"><b>@L["AuthorizedLoan"]</b></RadzenText>

                                                <div class="rz-mt-3">
                                                    <RadzenText TextStyle="TextStyle.Body2">@L["LoanDate"]</RadzenText>
                                                    <RadzenDatePicker @bind-Value="loanDate" Disabled="true" class="w-100" />
                                                </div>

                                                <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2">@L["ExpectedReturnDate"] :
                                                    <b>@adherentCheck.ExpectedReturnDate.ToShortDateString()</b>
                                                </RadzenText>
                                            </div>
                                            break;

                                        case CheckAdherentEnum.QUOTA_REACHED:
                                            <div class="rz-mt-2">
                                                <RadzenText TextStyle="TextStyle.Body2">@L["Quota"]: @adherentCheck.ActiveLoans /
                                                    @adherentCheck.Adherent?.Categorie?.NombreDocument</RadzenText>
                                                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-warning"><b>@L["QuotaReached"]</b></RadzenText>
                                            </div>
                                            break;

                                        case CheckAdherentEnum.PENALISED:
                                            <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="@L["Penalised"]" class="rz-mb-2" />
                                            break;

                                        case CheckAdherentEnum.SUSPENDED:
                                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="@L["Suspended"]" class="rz-mb-2" />
                                            break;
                                    }
                            </RadzenColumn>
                        </RadzenRow>
                    }
                }
                else if (hasSearchedMember && adherentCheck == null)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-danger">@L["ErrorWhileVerifyingMember"]</RadzenText>
                }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.H5">@L["DocumentInformations"]</RadzenText> @**@

                        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" class="rz-mt-3">
                            <RadzenTextBox Placeholder="@L["InsertCote"]" @oninput="OnCoteTyping" @bind-Value="Cote"
                                           Change="OnCoteChanged" class="w-100" /> @**@

                            @if (isLoadingDocument)
                            {
                                <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                            }
                             else if (noticeCheck != null)
                            {
                                @if (noticeCheck.Status != CheckNoticeEnum.NOT_FOUND)
                                {
                                    <RadzenText TextStyle="TextStyle.Subtitle1">@L["Title"] :</RadzenText>
                                    <RadzenText TextStyle="TextStyle.DisplayH5">@noticeCheck.Titre</RadzenText>
                                }

                                @switch (noticeCheck.Status)
                                {
                                    case CheckNoticeEnum.NOT_FOUND:
                                        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-mt-2">
                                            @L["CoteNotFound"]
                                        </RadzenAlert>
                                        break;

                                    case CheckNoticeEnum.CAN_BORROW:
                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2">@L["SelectACopy"] :</RadzenText>
                                        <RadzenDropDown @bind-Value="selectedCopyId" Data="@noticeCheck.Exemplaires" class="w-100" />
                                        break;

                                    case CheckNoticeEnum.CAN_BORROW_RESERVATEUR:
                                        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" class="rz-mt-2">
                                            @L["MemberHasReservedThisDocument"]
                                        </RadzenAlert>
                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2">@L["SelectACopy"] :</RadzenText>
                                        <RadzenDropDown @bind-Value="selectedCopyId" Data="@noticeCheck.Exemplaires" class="w-100" />
                                        break;

                                    case CheckNoticeEnum.CAN_RESERVE:
                                        <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="rz-mt-2">
                                            @L["NoAvailableCopiesCanReserve"]
                                        </RadzenAlert>
                                        break;

                                    case CheckNoticeEnum.RESERVED_NOT_READY:
                                        <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" class="rz-mt-2">
                                            @L["ReservedButCopyNotReady"]
                                        </RadzenAlert>
                                        break;

                                    case CheckNoticeEnum.PENALISED:
                                        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-mt-2">
                                            @L["AdherentPenalised"]
                                        </RadzenAlert>
                                        break;
                                }
                            }
                            else
                            {
                                @if (hasSearchedDocument)
                                {
                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-danger">@L["ErrorWhileSearchingCote"]
                                    </RadzenText>
                                }
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow class="rz-mt-4" JustifyContent="JustifyContent.End">
                @if (noticeCheck != null)
                {
                    @if (noticeCheck.Status == CheckNoticeEnum.CAN_RESERVE)
                    {
                        <RadzenButton class="rz-mr-2" Text="@L["ReserveDocument"]" Size="ButtonSize.Medium"
                                      ButtonStyle="ButtonStyle.Secondary" Click=ReserverCote />
                    }
                    @if ((noticeCheck.Status == CheckNoticeEnum.CAN_BORROW || noticeCheck.Status ==
                                            CheckNoticeEnum.CAN_BORROW_RESERVATEUR) && selectedCopyId != null)
                    {
                        <RadzenButton Disabled="!IsLoanValidatable" Click=ValiderPret Text="@L["ValidateLoan"]"
                                         ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Medium" class="rz-mr-2" />
                    }
                }
            </RadzenRow>


@code {
    private IEnumerable<PretResponseDto>? prets;
    private int count;
    private bool isLoading;

    private PretStatsDto? stats;
    protected override async Task OnPageInitializedAsync()
    {
        stats = await pretService.GetStats();
    }
    private async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;

        try
        {
            int skip = args.Skip ?? 0;
            int top = args.Top ?? 10;

            int pageNumber = (skip / top) + 1;

            var queryParams = new PaginatedQueryParameters
            {
                PageNumber = pageNumber,
                PageSize = top,
                OrderBy = args.OrderBy ?? "datepret desc"
            };

            var result = await pretService.GetPretsAsync(queryParams);

            prets = result.Data;
            count = result.TotalCount;
        }
        finally
        {
            isLoading = false;
        }
    }
    
    // UI Bound Variables
    string AdherentId = "";
    string Cote = "";
    string? selectedCopyId;
    DateTime loanDate = DateTime.Now.Date;

    bool IsLoanValidatable = false;
    // Member State
    bool isLoadingMember = false;
    bool hasSearchedMember = false;
    CheckAdhPretResponseDto? adherentCheck;
    CheckNoticeResponseDto? noticeCheck;

    bool isLoadingDocument = false;
    bool hasSearchedDocument = false;



    void OnMemberTyping(ChangeEventArgs e)
    {
        adherentCheck = null;
        noticeCheck = null;
        selectedCopyId = null;
    }

    void OnCoteTyping(ChangeEventArgs e)
    {
        noticeCheck = null;
        selectedCopyId = null;
    }
    // adherent check
    private async Task OnMemberIdChanged()
    {
        if (string.IsNullOrWhiteSpace(AdherentId))
        {
            ResetMemberState();
            return;
        }
        isLoadingMember = true;

        string searchId = AdherentId.Trim().ToUpper().Replace("/", "");
        adherentCheck = await pretService.CheckAdherent(searchId);
        hasSearchedMember = true;
        StateHasChanged();
        if (adherentCheck == null)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Detail = L["ErrorWhileVerifyingMember"], // ErrorWhileVerifyingMember
                Duration = 4000
            });
            ResetMemberState();
        }
        else
        {
            if (adherentCheck.Etat != CheckAdherentEnum.AUTHORIZED)
            {
                ShowNotification(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = L["Alert"], // Alert
                    Duration = 4000
                });
            }
        }
        isLoadingMember = false;
    }


    private void ResetMemberState()
    {

        adherentCheck = null;
        hasSearchedMember = false;
    }

    private async Task OnCoteChanged()
    {
        if (adherentCheck == null)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = L["MemberRequired"], //
                Detail = L["ValidateMemberBeforeDocument"]
                //
            });
            return;
        }
        if (adherentCheck.Etat != CheckAdherentEnum.AUTHORIZED)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = L["ThisMemberCantLoan"], //
            });
            return;
        }
        
        if (string.IsNullOrWhiteSpace(Cote))
        {
            ResetDocumentState();
            return;
        }
        selectedCopyId = null;
        isLoadingDocument = true;
        hasSearchedDocument = true;
        StateHasChanged();
        // Strip trailing path segments from barcode scan
        noticeCheck = await pretService.CheckNotice(Cote, AdherentId);
        ShowNotification(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = L["FetchedDocument"], //
        });
        if (noticeCheck != null && (noticeCheck.Status == CheckNoticeEnum.CAN_BORROW || noticeCheck.Status ==
CheckNoticeEnum.CAN_BORROW_RESERVATEUR))
        {
            IsLoanValidatable = adherentCheck != null && adherentCheck.Etat == CheckAdherentEnum.AUTHORIZED;
        }
        isLoadingDocument = false;
    }



    private void ResetDocumentState()
    {
        noticeCheck = null;
        selectedCopyId = null;
        hasSearchedDocument = false;
    }

    private async Task ValiderPret()
    {
        if (selectedCopyId == string.Empty)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = L["SelectACopy"], //
            });
            return;
        }
        CreatePretResponseDto result = await pretService.CreatePret(new CreatePretRequestDto
        {
            AdherentId = AdherentId,
            ExemplaireId = selectedCopyId!,
        });
        if (result.Done)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = L["LoanInsertedWithSuccess"], //
            });
            ResetDocumentState();
            ResetMemberState();
            return;
        }
        else
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = L["ErrorWhileInsertingLoan"], //
            });
            ResetDocumentState();
            ResetMemberState();
            return;
        }
    }

    public async Task ReserverCote()
    {
        CreateReservationResponseDto response = await pretService.CreateReservation(
            new CreateReservationRequestDto
            {
                AdherentId = AdherentId,
                Cote = Cote
            }
        );
        if (response.Done)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Reservation inseree avec succes",
            });
            ResetDocumentState();
            ResetMemberState();
            return;
        }
        else
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errur lors de creation de la reservation",
            });
            ResetDocumentState();
            ResetMemberState();
            return;
        }

    }



    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);
    }
}
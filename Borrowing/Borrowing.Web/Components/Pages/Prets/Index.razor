@page "/prets"
@using Borrowing.Web.Services
@using Borrowing.SharedClasses.Responses.Pret
@using Borrowing.SharedClasses.Common
@using Borrowing.SharedClasses.Requests.Pret

@rendermode InteractiveAuto
@inject IPretService pretService
@using Borrowing.SharedClasses.Responses.Adherent
@using Borrowing.SharedClasses.Responses.Notice
@using Radzen
@using Radzen.Blazor
@using Shared.Models

@inject NotificationService NotificationService

<RadzenRow class="rz-text-align-center " Gap="1rem">
    <RadzenColumn>
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.H6">Prets en cours</RadzenText>
                    <RadzenText TextStyle="TextStyle.H2" class="rz-color-success rz-m-0">
                        @(stats?.Prets ?? 0)
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn>
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.H6">En retard</RadzenText>
                    <RadzenText TextStyle="TextStyle.H2" class="rz-color-info rz-m-0">
                        @(stats?.Retard ?? 0)
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn>
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.H6">Reservations</RadzenText>
                    <RadzenText TextStyle="TextStyle.H2" class="rz-color-warning rz-m-0">
                        @(stats?.Reservations ?? 0)
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenText TextStyle="TextStyle.H3" class="rz-mt-4">Inserer un Pret</RadzenText>

<RadzenRow class="rz-mt-4">
    <RadzenColumn Size="12" SizeMD="6">
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenText TextStyle="TextStyle.H5">Information Adhérent</RadzenText>

            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" class="rz-mt-3">
                <RadzenTextBox Placeholder="Saisir l'ID Adhérent..." @bind-Value="AdherentId" @oninput="OnMemberTyping"
                               Change="OnMemberIdChanged" class="w-100" />

                @if (isLoadingMember)
                {
                    <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                }
                else if (hasSearchedMember && adherentCheck != null && adherentCheck.Etat != EtatAdherentEnum.NOT_FOUND)
                {
                    <RadzenRow>
                        <RadzenColumn Size="4">
                            <img src="@(adherentCheck.picture)" style="width: 100%; border-radius: 8px;"
                                 onerror="this.style.display='none'" />
                        </RadzenColumn>
                        <RadzenColumn Size="8">
                            <RadzenText TextStyle="TextStyle.Subtitle1"><b>@(adherentCheck.Adherent?.Nom?.ToUpper())
                                @adherentCheck.Adherent?.Prenom</b></RadzenText>
                                <RadzenText TextStyle="TextStyle.Body2">Catégorie:
                                    @adherentCheck.Adherent?.Categorie?.LibelleCategorie
                                </RadzenText>

                                @if (adherentCheck.Adherent?.EtatAdherent == 0)
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Actif" class="rz-mb-2" />
                                    @if (adherentCheck.Etat == EtatAdherentEnum.AUTHORIZED)
                                    {
                                        <div class="rz-mt-2">
                                            <RadzenText TextStyle="TextStyle.Body2">Quota: @adherentCheck.ActiveLoans /
                                                @adherentCheck.Adherent?.Categorie?.NombreDocument</RadzenText>
                                                
                                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-success"><b>Prêt Autorisé</b>
                                                    </RadzenText>

                                                    <div class="rz-mt-3">
                                                        <RadzenText TextStyle="TextStyle.Body2">Date du Prêt:</RadzenText>
                                                        <RadzenDatePicker @bind-Value="loanDate" Disabled="true" class="w-100" />
                                                    </div>

                                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2">Date Retour Prévue:
                                                        <b>@adherentCheck.ExpectedReturnDate.ToShortDateString()</b>
                                                    </RadzenText>
                                                </div>
                                    }
                                    else {
                                         <RadzenText TextStyle="TextStyle.Body2">Quota: @adherentCheck.ActiveLoans /
                                                @adherentCheck.Adherent?.Categorie?.NombreDocument</RadzenText>

                                         switch (adherentCheck.Etat)
                                         {
                                            case EtatAdherentEnum.QUOTA_REACHED:
                                                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-warning"><b>Quota Atteint</b>
                                                </RadzenText>
                                                break;
                                            case EtatAdherentEnum.PENALISED:
                                                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-danger"><b>Adhérent Pénalisé</b>
                                                </RadzenText>
                                                break;
                                         }
                                    }
                                }
                                else
                                {
                                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="Bloquee" class="rz-mb-2" />
                                }
                                </RadzenColumn>
                            </RadzenRow>
                            }
                            else if (hasSearchedMember && adherentCheck == null)
                            {
                                <RadzenText TextStyle="TextStyle.Body2" class="rz-color-danger">Adhérent introuvable.</RadzenText>
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>

                <RadzenColumn Size="12" SizeMD="6">
                    <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
                        <RadzenText TextStyle="TextStyle.H5">Information Document & Exemplaire</RadzenText>

                        <RadzenStack Orientation="Orientation.Vertical" Gap="1rem" class="rz-mt-3">
                            <RadzenTextBox Placeholder="Saisir la Cote et appuyez sur Entrée..." @oninput="OnCoteTyping"
                                           @bind-Value="Cote" Change="OnCoteChanged" class="w-100" />

                            @if (isLoadingDocument)
                            {
                                <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                            }
                            else if (noticeCheck != null)
                            {
                                <RadzenText TextStyle="TextStyle.Subtitle1">Titre :</RadzenText>
                                <RadzenText TextStyle="TextStyle.DisplayH5">@noticeCheck.Titre</RadzenText>
                                @if (noticeCheck.CanReserve && !noticeCheck.CanBorrow)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" class="rz-mt-2">
                                        Pas de copies disponibles pour pret, vous pouver faire une reservation
                                    </RadzenAlert>
                                }
                                @if (noticeCheck.Found == false)
                                {
                                    <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" class="rz-mt-2">
                                        Cote introuvable
                                    </RadzenAlert>
                                }
                                else
                                {

                                    @if (noticeCheck.CanBorrow)
                                    {
                                        @if (noticeCheck.Reservateur)
                                        {
                                            <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" class="rz-mt-2">L'adherent a fait une
                                                reservation de ce document
                                            </RadzenAlert>
                                        }
                                   
                                        <RadzenText TextStyle="TextStyle.Body2" class="rz-mt-2">Sélectionner un exemplaire :</RadzenText>
                                        <RadzenDropDown @bind-Value="selectedCopyId" Data="@noticeCheck.Exemplaires" class="w-100" />
                                    }
                                }
                                
                            }
                            else
                            {
                                @if (hasSearchedDocument)
                                {

                                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-danger">Document introuvable avec cette cote.
                                    </RadzenText>
                                }
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>

            <RadzenRow class="rz-mt-4" JustifyContent="JustifyContent.End">
                @if (noticeCheck != null)
                {
                    @if (noticeCheck.CanReserve)
                    {
                        <RadzenButton class="rz-mr-2" Text="Réserver ce document" Size="ButtonSize.Medium"
                                      ButtonStyle="ButtonStyle.Secondary" />
                    }
                    @if (noticeCheck.CanBorrow && selectedCopyId != null)
                    {

                        <RadzenButton Disabled="!IsLoanValidatable" Click=ValiderPret Text="Valider Prêt" ButtonStyle="ButtonStyle.Success"
                                      Size="ButtonSize.Medium" class="rz-mr-2" />
                    }

                }
            </RadzenRow>


@code {
    private IEnumerable<PretResponseDto>? prets;
    private int count;
    private bool isLoading;

    private PretStatsDto? stats;
    protected override async Task OnInitializedAsync()
    {
        stats = await pretService.GetStats();
    }
    private async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;

        try
        {
            int skip = args.Skip ?? 0;
            int top = args.Top ?? 10;

            int pageNumber = (skip / top) + 1;

            var queryParams = new PaginatedQueryParameters
            {
                PageNumber = pageNumber,
                PageSize = top,
                OrderBy = args.OrderBy ?? "datepret desc"
            };

            var result = await pretService.GetPretsAsync(queryParams);

            prets = result.Data;
            count = result.TotalCount;
        }
        finally
        {
            isLoading = false;
        }
    }
    
    // UI Bound Variables
    string AdherentId = "";
    string Cote = "";
    string? selectedCopyId;
    DateTime loanDate = DateTime.Now.Date;

    bool IsLoanValidatable = false;
    // Member State
    bool isLoadingMember = false;
    bool hasSearchedMember = false;
    CheckAdhPretResponseDto? adherentCheck;
    CheckNoticeResponseDto? noticeCheck;

    bool isLoadingDocument = false;
    bool hasSearchedDocument = false;



    void OnMemberTyping(ChangeEventArgs e)
    {
        adherentCheck = null;
        noticeCheck = null;
        selectedCopyId = null;
    }

    void OnCoteTyping(ChangeEventArgs e)
    {
        noticeCheck = null;
        selectedCopyId = null;
    }
    // adherent check
    private async Task OnMemberIdChanged()
    {
        if (string.IsNullOrWhiteSpace(AdherentId))
        {
            ResetMemberState();
            return;
        }
        isLoadingMember = true;

        string searchId = AdherentId.Trim().ToUpper().Replace("/", "");
        adherentCheck = await pretService.CheckAdherent(searchId);
        hasSearchedMember = true;
        StateHasChanged();
        if (adherentCheck == null)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Reponse Nulle",
                Detail =
                    "Erruer lors de verification d'adherent",
                Duration = 4000
            });
            ResetMemberState();
        }
        else
        {
            if (adherentCheck.Etat != EtatAdherentEnum.AUTHORIZED)
            {
                ShowNotification(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Caution",
                    Duration = 4000
                });
            }
        }
        isLoadingMember = false;
    }



    private void ResetMemberState()
    {

        adherentCheck = null;
        hasSearchedMember = false;
    }

    private async Task OnCoteChanged()
    {
        if (adherentCheck == null)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Adhérent requis",
                Detail = "Veuillez valider l'adhérent avant le document."
            });
            return;
        }
        if(adherentCheck.Etat != EtatAdherentEnum.AUTHORIZED)
        {
             ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "cet Adherent ne peut pas preter",
            });
            return;
        }
        
        if (string.IsNullOrWhiteSpace(Cote))
        {
            ResetDocumentState();
            return;
        }
        selectedCopyId = null;
        isLoadingDocument = true;
        hasSearchedDocument = true;
        StateHasChanged();
        // Strip trailing path segments from barcode scan
        noticeCheck = await pretService.CheckNotice(Cote, AdherentId);
        ShowNotification(new NotificationMessage
        {
            Severity = NotificationSeverity.Success,
            Summary = "Fetched notice",
        });
        if (noticeCheck != null && noticeCheck.CanBorrow)
        {
            IsLoanValidatable = adherentCheck != null && adherentCheck.Etat == EtatAdherentEnum.AUTHORIZED && noticeCheck.CanBorrow;
        }
        isLoadingDocument = false;
    }



    private void ResetDocumentState()
    {
        noticeCheck = null;
        selectedCopyId = null;
        hasSearchedDocument = false;
    }

    private async Task ValiderPret()
    {
        if (selectedCopyId == string.Empty)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "Selectionner un exemplaire",
            });
            return;
        }
        CreatePretResponseDto result = await pretService.CreatePret(new CreatePretRequestDto
        {
            AdherentId = AdherentId,
            ExemplaireId = selectedCopyId!,
        });
        if (result.Done)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Pret inseree avec succes",
                Detail = result.Message,
            });
            ResetDocumentState();
            ResetMemberState();
            return;
        }else{
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Errur lors de creation de pret",
                Detail = result.Message,
            });
            ResetDocumentState();
            ResetMemberState();
            return;
        }
    }

    



    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);
    }
}
@page "/adherents/{Id}"
@using Borrowing.SharedClasses.Common
@using Borrowing.SharedClasses.Requests.Adherent
@using Borrowing.SharedClasses.Responses.Adherent
@using Borrowing.SharedClasses.Responses.Categorie
@using Borrowing.SharedClasses.Responses.Position
@using Borrowing.Web.Components.Base
@using Borrowing.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IAdherentService AdherentService
@inject IExportService exportService
@inject IPositionService PositionService
@inject ICategorieService CategorieService
@inject IEtatAdherentService EtatAdherentService
@inject Radzen.DialogService DialogService
@inject Radzen.NotificationService NotificationService


@inherits AuthorizedComponentBase

@if (adherent == null)
{
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Style="margin-top:4rem">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <RadzenStack Gap="1.5rem" Style="padding: 2rem">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Style="align-items: stretch;">
            <RadzenCard Style="flex: 0 0 auto;">
                <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 100%;">
                    <RadzenImage Path="@adherent.Picture"
                                 Style="width:200px;height:200px;border-radius:50%;object-fit:cover" />
                </RadzenStack>
            </RadzenCard>
            <RadzenCard Style="flex: 1 1 auto;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="height: 100%;">
                    @if (isEditing)
                    {
                        <RadzenTemplateForm Data="@adherentDto" Submit="@SaveProfile" TItem="UpdateAdherentDto"
                                            Style="width: 100%;">
                            <RadzenStack Gap="0.5rem" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="adherentDto.IdAdherent" Placeholder="ID" Disabled="true"
                                               Style="width: 100%;" />
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenTextBox @bind-Value="adherentDto.Prenom" Placeholder="Prénom" Style="flex: 1;" />
                                    <RadzenTextBox @bind-Value="adherentDto.Nom" Placeholder="Nom" Style="flex: 1;" />
                                </RadzenStack>
                                <RadzenDropDown @bind-Value="adherentDto.IdCategorie" Data="@categories"
                                                TextProperty="LibelleCategorie" ValueProperty="IdCategorie"
                                                Placeholder="Sélectionner Catégorie" Style="width: 100%;" />
                                <RadzenDropDown @bind-Value="adherentDto.IdPosition" Data="@positions"
                                                TextProperty="LibellePosition" ValueProperty="IdPosition"
                                                Placeholder="Sélectionner Position" Style="width: 100%;" />
                                <RadzenDropDown @bind-Value="adherentDto.EtatAdherent" Data="@etats" TextProperty="DescEtat"
                                                ValueProperty="IdEtat" Placeholder="Sélectionner État" Style="width: 100%;" />
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton ButtonType="ButtonType.Submit" Text="Sauvegarder"
                                                  ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" />
                                    <RadzenButton Text="Annuler" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                  Click="CancelEdit" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenTemplateForm>
                    }
                    else
                    {
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.H3"
                                        Text="@($"{adherent.Adherent!.Prenom} {adherent.Adherent!.Nom}")" />
                            <RadzenText TextStyle="TextStyle.Subtitle1" Text="@($"ID : {adherent.Adherent!.IdAdherent}")" />
                            <RadzenText TextStyle="TextStyle.Subtitle1"
                                        Text="@($"Catégorie : {adherent.Adherent.Categorie!.LibelleCategorie ?? "—"}")" />
                            <RadzenText TextStyle="TextStyle.Subtitle1"
                                        Text="@($"Position : {adherent.Adherent.Position!.LibellePosition ?? "—"}")" />
                            @switch (adherent.Adherent!.EtatAdherent)
                            {
                                case 1:
                                    <RadzenBadge Style="width: fit-content;padding: 0 5px;"  BadgeStyle="BadgeStyle.Success" Text="En règle" />
                                    break;
                                case 2:
                                    <RadzenBadge Style="width: fit-content;padding: 0 5px;"  BadgeStyle="BadgeStyle.Warning" Text="Pénalisé" />
                                    break;
                                case 3:
                                    <RadzenBadge Style="width: fit-content;padding: 0 5px;"  BadgeStyle="BadgeStyle.Danger" Text="Suspendu" />
                                    break;
                            }
                        
                        </RadzenStack>
                    }
                    <RadzenStack Style="margin-left:auto" AlignItems="AlignItems.End" Orientation="Orientation.Vertical"
                                 Gap="0.5rem">

                        
                        @if (isAdmin && !isEditing)
                        {
                            <RadzenButton Text="Éditer le profil" Icon="edit" ButtonStyle="ButtonStyle.Secondary"
                                          Size="ButtonSize.Medium" Click="EditProfile" />
                        }
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenStack>
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="Prêts" />
                <RadzenButton Text="Exporter" Icon="download" Click="@ExportPrets" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.Prets" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="Aucun prêt">
                <Columns>
                    <RadzenDataGridColumn Property="IdExemplaire" Title="Exemplaire" />
                    <RadzenDataGridColumn Property="DatePret" Title="Date de prêt" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn Property="EtatDuree" Title="État durée" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>


       
       
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="Pénalités" />
                <RadzenButton Text="Exporter" Icon="download" Click="@ExportPenalites" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.PenaliteAdherents" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="Aucune pénalité">
                <Columns>
                    <RadzenDataGridColumn Property="DatePenalite" Title="Date" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn Property="NombreJoursPenalite" Title="Nombre de jours">
                        <Template Context="item">
                            @Math.Abs(item.NombreJoursPenalite ?? 0)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="Actions" Visible="@isAdmin" Width="100px" Filterable="false"
                                          Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="penalite">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          Click="@(args => DeletePenalite((Shared.Models.PenaliteAdherent)penalite))"
                                          @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="Réservations" />
                <RadzenButton Text="Exporter" Icon="download" Click="@ExportReservations" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.Reservations" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="Aucune réservation">
                <Columns>
                    <RadzenDataGridColumn Property="Cote" Title="Cote" />
                    <RadzenDataGridColumn Property="HeureReservation" Title="Date" FormatString="{0:dd/MM/yyyy HH:mm}" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="Historique des Prêts" />
                <RadzenButton Text="Exporter" Icon="download" Click="@ExportPrets" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.HistoriquePrets" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="Aucun prêt en historique">
                <Columns>
                    <RadzenDataGridColumn Property="IdExemplaire" Title="Exemplaire" />
                    <RadzenDataGridColumn Property="DatePret" Title="Date de prêt" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn Property="DateRetour" Title="Date de retour" FormatString="{0:dd/MM/yyyy}" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="Historique de penalites" />
                <RadzenButton Text="Exporter" Icon="download" Click="@ExportPenalites" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.HistoriquePenaliteAdherents" AllowSorting="true" AllowPaging="true"
                            PageSize="5" EmptyText="Aucune pénalité">
                <Columns>
                    <RadzenDataGridColumn Property="DatePenalite" Title="Date" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn Property="NombreJoursPenalite" Title="Nombre de jours" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>

    </RadzenStack>
}


@code {

    private AdherentProfileDto? adherent;
    private bool isAdmin = false;
    private bool isEditing = false;
    private int confirmationStep = 0;
    private string warningMessage = "Vous êtes sur le point de modifier les informations de cet adhérent. Veuillez vérifier que toutes les données sont correctes avant de continuer.";

    private UpdateAdherentDto adherentDto = new();
    private IEnumerable<CategorieDto> categories = Array.Empty<CategorieDto>();
    private IEnumerable<PositionDto> positions = Array.Empty<PositionDto>();
    private IEnumerable<EtatAdherentDto> etats = Array.Empty<EtatAdherentDto>();

    [Parameter]
    public string Id { get; set; } = string.Empty;


    protected override async Task OnPageInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("ADMIN");

        Console.WriteLine("A");
        adherent = await AdherentService.GetAdherent(Id);
        Console.WriteLine("B");

        if (adherent == null)
        {
            Navigation.NavigateTo("/not-found");
        }
        else if (isAdmin)
        {
            categories = await CategorieService.GetAllCategoriesAsync();
            positions = await PositionService.GetAllPositionsAsync();
            etats = await EtatAdherentService.GetAllEtatsAsync();
        }
    }

    private void EditProfile()
    {
        adherentDto = new UpdateAdherentDto
        {
            IdAdherent = adherent!.Adherent!.IdAdherent,
            Nom = adherent.Adherent.Nom ?? "",
            Prenom = adherent.Adherent.Prenom ?? "",
            IdPosition = adherent.Adherent.IdPosition ?? 0,
            IdCategorie = adherent.Adherent.IdCategorie ?? "",
            EtatAdherent = (int)(adherent.Adherent.EtatAdherent!)
        };
        isEditing = true;
    }

    

    private async Task SaveProfile()
    {
        confirmationStep = 0;
        await DialogService.OpenAsync("Confirmation de mise à jour", ds =>
        @<RadzenStack Gap="1rem">
            <RadzenSteps @bind-SelectedIndex="confirmationStep" Change="OnStepChange">
                <Steps>
                    <RadzenStepsItem Text="Avertissement">
                        <RadzenCard
                            Style="background-color: var(--rz-warning-light); border-left: 4px solid var(--rz-warning);">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                                <RadzenIcon Icon="warning" Style="color: var(--rz-black); font-size: 2rem;" />
                                <RadzenStack Gap="0.5rem">
                                    <RadzenText TextStyle="TextStyle.H6" Text="Attention" />
                                    <RadzenText Text="@warningMessage" Style="width: 100%; min-width: 400px;" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                                     Style="margin-top: 1rem;">
                        </RadzenStack>
                    </RadzenStepsItem>
                    <RadzenStepsItem Text="Confirmation">
                        <RadzenCard Style="background-color: var(--rz-danger-light); border-left: 4px solid var(--rz-danger);">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                                <RadzenIcon Icon="info" Style="color: var(--rz-black); font-size: 2rem;" />
                                <RadzenStack Gap="0.5rem">
                                    <RadzenText TextStyle="TextStyle.H6" Text="Confirmation finale" />
                                    <RadzenText
                                    Text="Êtes-vous sûr de vouloir enregistrer ces modifications ? Cette action est irréversible." />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                                     Style="margin-top: 1rem;">
                            <RadzenButton Text="Confirmer" ButtonStyle="ButtonStyle.Success"
                                          Click="async () => { ds.Close(true); await ConfirmUpdate(); }" />
                        </RadzenStack>
                    </RadzenStepsItem>
                </Steps>
            </RadzenSteps>
        </RadzenStack>
        , new DialogOptions() { Width = "600px", Height = "auto", CloseDialogOnOverlayClick = false });
    }

  
    private async Task ConfirmUpdate()
    {
        var success = await AdherentService.UpdateAdherentAsync(adherentDto);
        if (success)
        {
            adherent = await AdherentService.GetAdherent(Id);
            isEditing = false;
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Succès",
                Detail = "Profil mis à jour."
            });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erreur",
                Detail = "Impossible de mettre à jour le profil."
            });
        }
    }

    private async Task ExportPrets()
    {
        if (adherent?.Adherent?.Prets == null) return;

        var exportData = adherent.Adherent.Prets.Select(p => new
        {
            Exemplaire = p.IdExemplaire,
            DatePret = p.DatePret.ToString("dd/MM/yyyy"),
            EtatDuree = p.EtatDuree
        });

        await exportService.ExportToExcelAsync(exportData,
$"Prets_{adherent.Adherent.IdAdherent}_{DateTime.Now:yyyyMMdd_HHmmss}");
    }

    private async Task ExportPenalites()
    {
        if (adherent?.Adherent?.PenaliteAdherents == null) return;

        var exportData = adherent.Adherent.PenaliteAdherents.Select(p => new
        {
            Date = p.DatePenalite.ToString("dd/MM/yyyy"),
            Jours = p.NombreJoursPenalite
        });

        await exportService.ExportToExcelAsync(exportData,
$"Penalites_{adherent.Adherent.IdAdherent}_{DateTime.Now:yyyyMMdd_HHmmss}");
    }

    private async Task ExportReservations()
    {
        if (adherent?.Adherent?.Reservations == null) return;

        var exportData = adherent.Adherent.Reservations.Select(r => new
        {
            Cote = r.Cote,
            Date = r.HeureReservation.ToString("dd/MM/yyyy HH:mm")
        });

        await exportService.ExportToExcelAsync(exportData,
$"Reservations_{adherent.Adherent.IdAdherent}_{DateTime.Now:yyyyMMdd_HHmmss}");
    }

    private async Task DeletePenalite(Shared.Models.PenaliteAdherent penalite)
    {
        var confirm = await DialogService.Confirm("Êtes-vous sûr de vouloir supprimer cette pénalité ?", "Confirmation", new
ConfirmOptions()
        { OkButtonText = "Oui", CancelButtonText = "Non" });
        if (confirm == true)
        {
            var success = await AdherentService.DeletePenaliteAsync(penalite.IdAdherent, penalite.DatePenalite);
            if (success)
            {
                adherent!.Adherent!.PenaliteAdherents.Remove(penalite);
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Succès",
                    Detail = "Pénalité supprimée."
                });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erreur",
                    Detail = "Impossible de supprimer la pénalité."
                });
            }
        }
    }
    private void CancelEdit()
    {
        isEditing = false;
    }
    private void OnStepChange(int index)
    {
        confirmationStep = index;
    }
}
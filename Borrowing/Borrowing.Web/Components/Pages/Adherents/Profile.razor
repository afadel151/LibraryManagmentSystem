@page "/adherents/{Id}"
@using Borrowing.SharedClasses.Models
@using Borrowing.SharedClasses.Requests.Adherent
@using Borrowing.SharedClasses.Responses.Adherent
@using Borrowing.SharedClasses.Responses.Categorie
@using Borrowing.SharedClasses.Responses.Position
@using Borrowing.Web.Components.Base
@using Borrowing.Web.Providers
@using Borrowing.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@inject NavigationManager Navigation
@inject IStringLocalizer<Profile> L
@inject IAdherentService AdherentService
@inject IExportService exportService
@inject IPositionService PositionService
@inject ICategorieService CategorieService
@inject IEtatAdherentService EtatAdherentService
@inject Radzen.DialogService DialogService
@inject Radzen.NotificationService NotificationService

@inject IImageHelper imageHelper

@inherits AuthorizedComponentBase

@if (adherent == null)
{
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Style="margin-top:4rem">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <RadzenStack Gap="1.5rem" Style="padding: 2rem">
        <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem" Style="align-items: stretch;">
            <RadzenCard Style="flex: 0 0 auto;">
                <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" Style="height: 100%;">
                    <RadzenImage Path="@imageUrl"
                                 Style="height:200px;object-fit:cover" />
                </RadzenStack>
            </RadzenCard>
            <RadzenCard Style="flex: 1 1 auto;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Style="height: 100%;">
                    @if (isEditing)
                    {
                        <RadzenTemplateForm Data="@adherentDto" Submit="@SaveProfile" TItem="UpdateAdherentDto"
                                            Style="width: 100%;">
                            <RadzenStack Gap="0.5rem" Style="width: 100%;">
                                <RadzenTextBox @bind-Value="adherentDto.IdAdherent" Placeholder="@L["Id"]" Disabled="true"
                                               Style="width: 100%;" />
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenTextBox @bind-Value="adherentDto.Prenom" Placeholder="@L["FirstName"]" Style="flex: 1;" />
                                    <RadzenTextBox @bind-Value="adherentDto.Nom" Placeholder="@L["LastName"]" Style="flex: 1;" />
                                </RadzenStack>
                                <RadzenDropDown @bind-Value="adherentDto.IdCategorie" Data="@categories"
                                                TextProperty="LibelleCategorie" ValueProperty="IdCategorie"
                                                Placeholder="@L["SelectCategory"]" Style="width: 100%;" />
                                <RadzenDropDown @bind-Value="adherentDto.IdPosition" Data="@positions"
                                                TextProperty="LibellePosition" ValueProperty="IdPosition"
                                                Placeholder="@L["SelectPosition"]" Style="width: 100%;" />
                                <RadzenDropDown @bind-Value="adherentDto.EtatAdherent" Data="@etats" TextProperty="DescEtat"
                                                ValueProperty="IdEtat" Placeholder="@L["SelectState"]" Style="width: 100%;" />
                                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                                    <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]"
                                                  ButtonStyle="ButtonStyle.Success" Size="ButtonSize.Small" />
                                    <RadzenButton Text="@L["Cancel"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                                  Click="CancelEdit" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenTemplateForm>
                    }
                    else
                    {
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.H3"
                                        Text="@($"{adherent.Adherent!.Prenom} {adherent.Adherent!.Nom}")" />
                            <RadzenText TextStyle="TextStyle.Subtitle1" Text="@($"ID : {adherent.Adherent!.IdAdherent}")" />
                            <RadzenText TextStyle="TextStyle.Subtitle1"
                                        Text="@($"{L["Category"]} : {adherent.Adherent.Categorie!.LibelleCategorie ?? "—"}")" />
                            <RadzenText TextStyle="TextStyle.Subtitle1"
                                        Text="@($"{L["Position"]} : {adherent.Adherent.Position!.LibellePosition ?? "—"}")" />
                            @switch (adherent.Adherent!.EtatAdherent)
                            {
                                case 1:
                                    <RadzenBadge Style="width: fit-content;padding: 0 5px;"  BadgeStyle="BadgeStyle.Success" Text="@L["Active"]" />
                                    break;
                                case 2:
                                    <RadzenBadge Style="width: fit-content;padding: 0 5px;"  BadgeStyle="BadgeStyle.Warning" Text="@L["Penalised"]" />
                                    break;
                                case 3:
                                    <RadzenBadge Style="width: fit-content;padding: 0 5px;"  BadgeStyle="BadgeStyle.Danger" Text="@L["Suspended"]" />
                                    break;
                            }
                        
                        </RadzenStack>
                    }
                    <RadzenStack Style="margin-left:auto" AlignItems="AlignItems.End" Orientation="Orientation.Vertical"
                                 Gap="0.5rem">

                        
                        @if (isAdmin && !isEditing)
                        {
                            <RadzenButton Text="@L["EditProfile"]" Icon="edit" ButtonStyle="ButtonStyle.Secondary"
                                          Size="ButtonSize.Medium" Click="EditProfile" />
                        }
                    </RadzenStack>
                </RadzenStack>
            </RadzenCard>
        </RadzenStack>
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="@L["Loans"]" />
                <RadzenButton Text="@L["Export"]" Icon="download" Click="@ExportPrets" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.Prets" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="@L["NoLoan"]">
                <Columns>
                    <RadzenDataGridColumn Property="IdExemplaire" Title="@L["Copy"]" />
                    <RadzenDataGridColumn Property="DatePret" Title="@L["LoanDate"]" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn Property="EtatDuree" Title="@L["DurationState"]" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>


       
       
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="@L["Penalites"]" />
                <RadzenButton Text="@L["Export"]" Icon="download" Click="@ExportPenalites" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.PenaliteAdherents" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="@L["NoPenalty"]">
                <Columns>
                    <RadzenDataGridColumn Property="DatePenalite" Title="@L["Date"]" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn Property="NombreJoursPenalite" Title="@L["Days"]">
                        <Template Context="item">
                            @Math.Abs(item.NombreJoursPenalite ?? 0)
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn Title="@L["Actions"]" Visible="@isAdmin" Width="100px" Filterable="false"
                                          Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="penalite">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                          Click="@(args => DeletePenalite((Common.Models.PenaliteAdherent)penalite))"
                                          @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="@L["Reservations"]" />
                <RadzenButton Text="@L["Export"]" Icon="download" Click="@ExportReservations" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.Reservations" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="@L["NoReservation"]">
                <Columns>
                    <RadzenDataGridColumn Property="Cote" Title="@L["Cote"]" />
                    <RadzenDataGridColumn Property="HeureReservation" Title="@L["ReservationDate"]" FormatString="{0:dd/MM/yyyy HH:mm}" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="@L["LoanHistory"]" />
                <RadzenButton Text="@L["Export"]" Icon="download" Click="@ExportPrets" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.HistoriquePrets" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="@L["NoLoanHistory"]">
                <Columns>
                    <RadzenDataGridColumn Property="IdExemplaire" Title="@L["Copy"]" />
                    <RadzenDataGridColumn Property="DatePret" Title="@L["LoanDate"]" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn Property="DateRetour" Title="@L["ReturnDate"]" FormatString="{0:dd/MM/yyyy}" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.DisplayH5" Text="@L["PenaltyHistory"]" />
                <RadzenButton Text="@L["Export"]" Icon="download" Click="@ExportPenalites" ButtonStyle="ButtonStyle.Light"
                              Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.HistoriquePenaliteAdherents" AllowSorting="true" AllowPaging="true"
                            PageSize="5" EmptyText="@L["NoPenaltyHistory"]">
                <Columns>
                    <RadzenDataGridColumn Property="DatePenalite" Title="Date" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn Property="NombreJoursPenalite" Title="Nombre de jours" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>

    </RadzenStack>
}


@code {

    private AdherentProfileDto? adherent;
    private bool isAdmin = false;
    private bool isEditing = false;
    private int confirmationStep = 0;
    private string warningMessage = "";

    private string imageUrl = "";
    private UpdateAdherentDto adherentDto = new();
    private IEnumerable<CategorieDto> categories = Array.Empty<CategorieDto>();
    private IEnumerable<PositionDto> positions = Array.Empty<PositionDto>();
    private IEnumerable<EtatAdherentDto> etats = Array.Empty<EtatAdherentDto>();

    [Parameter]
    public string Id { get; set; } = string.Empty;


    protected override async Task OnPageInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("ADMIN");

        adherent = await AdherentService.GetAdherent(Id);

        if (adherent == null)
        {
            Navigation.NavigateTo("/not-found");
        }
        else if (isAdmin)
        {
            categories = await CategorieService.GetAllCategoriesAsync();
            positions = await PositionService.GetAllPositionsAsync();
            etats = await EtatAdherentService.GetAllEtatsAsync();
        }
        imageUrl = imageHelper.GetSmallImageUrl(Id);
    }

    private void EditProfile()
    {
        adherentDto = new UpdateAdherentDto
        {
            IdAdherent = adherent!.Adherent!.IdAdherent,
            Nom = adherent.Adherent.Nom ?? "",
            Prenom = adherent.Adherent.Prenom ?? "",
            IdPosition = adherent.Adherent.IdPosition ?? 0,
            IdCategorie = adherent.Adherent.IdCategorie ?? "",
            EtatAdherent = (int)(adherent.Adherent.EtatAdherent!)
        };
        isEditing = true;
    }

    

    private async Task SaveProfile()
    {
        confirmationStep = 0;
        await DialogService.OpenAsync(L["UpdateProfile"], ds =>
        @<RadzenStack Gap="1rem">
            <RadzenSteps @bind-SelectedIndex="confirmationStep" Change="OnStepChange">
                <Steps>
                    <RadzenStepsItem Text="Avertissement">
                        <RadzenCard
                            Style="background-color: var(--rz-warning-light); border-left: 4px solid var(--rz-warning);">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                                <RadzenIcon Icon="warning" Style="color: var(--rz-black); font-size: 2rem;" />
                                <RadzenStack Gap="0.5rem">
                                    <RadzenText TextStyle="TextStyle.H6" Text="n" />
                                    <RadzenText Text="@L["WarningMessage"]" Style="width: 100%; min-width: 400px;" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                                     Style="margin-top: 1rem;">
                        </RadzenStack>
                    </RadzenStepsItem>
                    <RadzenStepsItem Text="Confirmation">
                        <RadzenCard Style="background-color: var(--rz-danger-light); border-left: 4px solid var(--rz-danger);">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                                <RadzenIcon Icon="info" Style="color: var(--rz-black); font-size: 2rem;" />
                                <RadzenStack Gap="0.5rem">
                                    <RadzenText TextStyle="TextStyle.H6" Text="@L["FinalConfirmation"]" />
                                    <RadzenText
                                    Text="@L["ConfirmUpdateMessage"]" />
                                </RadzenStack>
                            </RadzenStack>
                        </RadzenCard>
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                                     Style="margin-top: 1rem;">
                            <RadzenButton Text="@L["Confirm"]" ButtonStyle="ButtonStyle.Success"
                                          Click="async () => { ds.Close(true); await ConfirmUpdate(); }" />
                        </RadzenStack>
                    </RadzenStepsItem>
                </Steps>
            </RadzenSteps>
        </RadzenStack>
        , new DialogOptions() { Width = "600px", Height = "auto", CloseDialogOnOverlayClick = false });
    }

  
    private async Task ConfirmUpdate()
    {
        var success = await AdherentService.UpdateAdherentAsync(adherentDto);
        if (success)
        {
            adherent = await AdherentService.GetAdherent(Id);
            isEditing = false;
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = L["Success"],
                Detail = L["UpdateProfileSuccess"]
            });
        }
        else
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = L["Error"],
                Detail = L["UpdateProfileError"]
            });
        }
    }

    private async Task ExportPrets()
    {
        if (adherent?.Adherent?.Prets == null) return;

        var exportData = adherent.Adherent.Prets.Select(p => new
        {
            Exemplaire = p.IdExemplaire,
            DatePret = p.DatePret.ToString("dd/MM/yyyy"),
            EtatDuree = p.EtatDuree
        });

        await exportService.ExportToExcelAsync(exportData,
$"Prets_{adherent.Adherent.IdAdherent}_{DateTime.Now:yyyyMMdd_HHmmss}");
    }

    private async Task ExportPenalites()
    {
        if (adherent?.Adherent?.PenaliteAdherents == null) return;

        var exportData = adherent.Adherent.PenaliteAdherents.Select(p => new
        {
            Date = p.DatePenalite.ToString("dd/MM/yyyy"),
            Jours = p.NombreJoursPenalite
        });

        await exportService.ExportToExcelAsync(exportData,
$"Penalites_{adherent.Adherent.IdAdherent}_{DateTime.Now:yyyyMMdd_HHmmss}");
    }

    private async Task ExportReservations()
    {
        if (adherent?.Adherent?.Reservations == null) return;

        var exportData = adherent.Adherent.Reservations.Select(r => new
        {
            Cote = r.Cote,
            Date = r.HeureReservation.ToString("dd/MM/yyyy HH:mm")
        });

        await exportService.ExportToExcelAsync(exportData,
$"Reservations_{adherent.Adherent.IdAdherent}_{DateTime.Now:yyyyMMdd_HHmmss}");
    }

    private async Task DeletePenalite(Common.Models.PenaliteAdherent penalite)
    {
        var confirm = await DialogService.Confirm(L["ConfirmDeletePenalty"], L["Confirmation"], new
ConfirmOptions()
        { OkButtonText = L["Yes"], CancelButtonText = L["No"] });
        if (confirm == true)
        {
            var success = await AdherentService.DeletePenaliteAsync(penalite.IdAdherent, penalite.DatePenalite);
            if (success)
            {
                adherent!.Adherent!.PenaliteAdherents.Remove(penalite);
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = L["Success"],
                    Detail = L["DeletePenaltySuccess"]
                });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = L["Error"],
                    Detail = L["DeletePenaltyError"]
                });
            }
        }
    }
    private void CancelEdit()
    {
        isEditing = false;
    }
    private void OnStepChange(int index)
    {
        confirmationStep = index;
    }
}
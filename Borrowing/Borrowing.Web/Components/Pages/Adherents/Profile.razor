@page "/adherents/{Id}"
@using Borrowing.SharedClasses.Responses.Adherent
@using Borrowing.Web.Services
@inject NavigationManager Navigation
@inject IAdherentService AdherentService
@inject IExportService exportService
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject Radzen.DialogService DialogService
@inject Radzen.NotificationService NotificationService

@if (adherent == null)
{
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Style="margin-top:4rem">
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    </RadzenStack>
}
else
{
    <RadzenStack Gap="1.5rem" Style="padding: 2rem">
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1.5rem">
                <RadzenImage Path="@adherent.Picture" Style="width:150px;height:150px;border-radius:50%;object-fit:cover" />
                <RadzenStack Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.H4"
                                Text="@($"{adherent.Adherent!.Prenom} {adherent.Adherent!.Nom}")" />
                    <RadzenText TextStyle="TextStyle.Body1" Text="@($"ID : {adherent.Adherent!.IdAdherent}")" />
                    <RadzenText TextStyle="TextStyle.Body1"
                                Text="@($"Catégorie : {adherent.Adherent.Categorie!.LibelleCategorie ?? "—"}")" />
                    <RadzenText TextStyle="TextStyle.Body1"
                                Text="@($"Position : {adherent.Adherent.Position!.LibellePosition ?? "—"}")" />
                </RadzenStack>
                <RadzenStack Style="margin-left:auto" AlignItems="AlignItems.End" Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenBadge
                        BadgeStyle="@(adherent.Adherent!.EtatAdherent == 0 ? BadgeStyle.Success : BadgeStyle.Danger)"
                        Text="@(adherent.Adherent!.EtatAdherent == 0 ? "Actif" : "Inactif")" />
                    <RadzenBadge
                    BadgeStyle="@(adherent.Adherent!.PenaliteAdherents.Count == 0 ? BadgeStyle.Success : BadgeStyle.Danger)"
                    Text="@(adherent.Adherent!.PenaliteAdherents.Count == 0 ? "Non pénalisé" : "Pénalisé")" />
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
         <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.H6" Text="Prêts" />
                <RadzenButton Text="Exporter" Icon="download" Click="@ExportPrets" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.Prets" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="Aucun prêt">
                <Columns>
                    <RadzenDataGridColumn Property="IdExemplaire" Title="Exemplaire" />
                    <RadzenDataGridColumn Property="DatePret" Title="Date de prêt" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn Property="EtatDuree" Title="État durée" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>


       
       
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.H6" Text="Pénalités" />
                <RadzenButton Text="Exporter" Icon="download" Click="@ExportPenalites" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.PenaliteAdherents" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="Aucune pénalité">
                <Columns>
                    <RadzenDataGridColumn Property="DatePenalite" Title="Date" FormatString="{0:dd/MM/yyyy}" />
                    <RadzenDataGridColumn Property="NombreJoursPenalite" Title="Nombre de jours" />
                    <RadzenDataGridColumn Title="Actions" Visible="@isAdmin" Width="100px" Filterable="false" Sortable="false" TextAlign="TextAlign.Center">
                        <Template Context="penalite">
                            <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" 
                                          Click="@(args => DeletePenalite((Shared.Models.PenaliteAdherent)penalite))" @onclick:stopPropagation="true" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
         <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Style="margin-bottom:1rem">
                <RadzenText TextStyle="TextStyle.H6" Text="Réservations" />
                <RadzenButton Text="Exporter" Icon="download" Click="@ExportReservations" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" />
            </RadzenStack>
            <RadzenDataGrid Data="@adherent.Adherent!.Reservations" AllowSorting="true" AllowPaging="true" PageSize="5"
                            EmptyText="Aucune réservation">
                <Columns>
                    <RadzenDataGridColumn Property="Cote" Title="Cote" />
                    <RadzenDataGridColumn Property="HeureReservation" Title="Date" FormatString="{0:dd/MM/yyyy HH:mm}" />
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>
    </RadzenStack>
}


@code {

    private AdherentProfileDto? adherent;
    private bool isAdmin = false;

    [Parameter]
    public string Id { get; set; } = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("Admin");

        Console.WriteLine("A");
        adherent = await AdherentService.GetAdherent(Id);
        Console.WriteLine("B");
        if (adherent == null)
        {
            Navigation.NavigateTo("/not-found");
        }
    }

    private async Task ExportPrets()
    {
        if (adherent?.Adherent?.Prets == null) return;

        var exportData = adherent.Adherent.Prets.Select(p => new
        {
            Exemplaire = p.IdExemplaire,
            DatePret = p.DatePret.ToString("dd/MM/yyyy"),
            EtatDuree = p.EtatDuree
        });

        await exportService.ExportToExcelAsync(exportData, $"Prets_{adherent.Adherent.IdAdherent}_{DateTime.Now:yyyyMMdd_HHmmss}");
    }

    private async Task ExportPenalites()
    {
        if (adherent?.Adherent?.PenaliteAdherents == null) return;

        var exportData = adherent.Adherent.PenaliteAdherents.Select(p => new
        {
            Date = p.DatePenalite.ToString("dd/MM/yyyy"),
            Jours = p.NombreJoursPenalite
        });

        await exportService.ExportToExcelAsync(exportData, $"Penalites_{adherent.Adherent.IdAdherent}_{DateTime.Now:yyyyMMdd_HHmmss}");
    }

    private async Task ExportReservations()
    {
        if (adherent?.Adherent?.Reservations == null) return;

        var exportData = adherent.Adherent.Reservations.Select(r => new
        {
            Cote = r.Cote,
            Date = r.HeureReservation.ToString("dd/MM/yyyy HH:mm")
        });

        await exportService.ExportToExcelAsync(exportData, $"Reservations_{adherent.Adherent.IdAdherent}_{DateTime.Now:yyyyMMdd_HHmmss}");
    }

    private async Task DeletePenalite(Shared.Models.PenaliteAdherent penalite)
    {
        var confirm = await DialogService.Confirm("Êtes-vous sûr de vouloir supprimer cette pénalité ?", "Confirmation", new ConfirmOptions() { OkButtonText = "Oui", CancelButtonText = "Non" });
        if (confirm == true)
        {
            var success = await AdherentService.DeletePenaliteAsync(penalite.IdAdherent, penalite.DatePenalite);
            if (success)
            {
                adherent!.Adherent!.PenaliteAdherents.Remove(penalite);
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Success, Summary = "Succès", Detail = "Pénalité supprimée." });
            }
            else
            {
                NotificationService.Notify(new NotificationMessage { Severity = NotificationSeverity.Error, Summary = "Erreur", Detail = "Impossible de supprimer la pénalité." });
            }
        }
    }
}
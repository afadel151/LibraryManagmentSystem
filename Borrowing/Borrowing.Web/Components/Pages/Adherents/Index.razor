@page "/adherents"


@inject NavigationManager navigationManager
@inject IAdherentService adherentService
@using Borrowing.SharedClasses.Responses.Adherent
@using Borrowing.SharedClasses.Responses.Notice
@using Borrowing.Web.Components.Base
@using Borrowing.Web.Services
@using Radzen
@using Radzen.Blazor
@using Shared.Models
@using Borrowing.SharedClasses.Common
@inject IExportService exportService
@inject DialogService dialogService
@inject NotificationService notificationService
@inject ICategorieService categorieService
@inject IPositionService positionService

@inherits AuthorizedComponentBase

<RadzenRow class="rz-text-align-center " Gap="1rem">
    <RadzenColumn>
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.H6">Adherents actifs</RadzenText>
                    <RadzenText TextStyle="TextStyle.H2" class="rz-color-success rz-m-0">
                        @(stats?.TotalActif ?? 0)
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn>
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.H6">Pretants en cours</RadzenText>
                    <RadzenText TextStyle="TextStyle.H2" class="rz-color-info rz-m-0">
                        @(stats?.Pretants ?? 0)
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn>
        <RadzenCard Variant="Variant.Filled" Style="height: 100%;">
            <RadzenStack JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Start"
                             JustifyContent="JustifyContent.SpaceBetween">
                    <RadzenText TextStyle="TextStyle.H6">Penalises</RadzenText>
                    <RadzenText TextStyle="TextStyle.H2" class="rz-color-warning rz-m-0">
                        @(stats?.Penalises ?? 0)
                    </RadzenText>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenStack class="rz-mt-4" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center">
    <RadzenText TextStyle="TextStyle.H3">Total adherents</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <RadzenTextBox Placeholder="Rechercher par ID,Nom ou Prenom..." style="width:400px" @bind-Value="SearchText"
                       @oninput="DoSearch" Change="DoSearch" />
        <RadzenButton Text="@(isExporting ? "Export..." : "Exporter")" Icon="get_app" Click="Export"
                      ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat" />
        <Microsoft.AspNetCore.Components.Authorization.AuthorizeView Roles="ADMIN">
            <RadzenButton Text="Ajouter un adhérent" Icon="add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                          Click="OpenCreateModal" />
        </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
    </RadzenStack>
</RadzenStack>
<RadzenRow class="rz-mt-4">
    <RadzenColumn>
        <RadzenDataGrid PagerHorizontalAlign="HorizontalAlign.Justify" Data="@adherents" Count="@count"
                        LoadData="@LoadData" IsLoading="@isLoading" TItem="AdherentDto" ShowPagingSummary="true" AllowPaging="true"
                        PageSize="10" AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn TItem="AdherentDto" Property="IdAdherent" Title="Identifiant" />
                <RadzenDataGridColumn TItem="AdherentDto" Property="Nom" Title="Nom Adhérent" />
                <RadzenDataGridColumn TItem="AdherentDto" Property="Prenom" Title="Prénom" />
                <RadzenDataGridColumn TItem="AdherentDto" Property="Categorie" Title="Catégorie" />
                <RadzenDataGridColumn TItem="AdherentDto" Property="Position" Title="Position" />
                <RadzenDataGridColumn TItem="AdherentDto" Property="Etat" Title="Etat">
                    <Template Context="data">
                        @if (data.Etat == 0)
                        {
                            <RadzenBadge Shade="Shade.Light" BadgeStyle="BadgeStyle.Success" Text="Actif" />
                        }
                        else
                        {
                            <RadzenBadge Shade="Shade.Light" BadgeStyle="BadgeStyle.Danger" Text="Inactif" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AdherentDto" Property="Prets" Title="Pres en cours" />
                <RadzenDataGridColumn TItem="AdherentDto" Property="Reservations" Title="Reservations en cours" />
                <RadzenDataGridColumn TItem="AdherentDto" Property="Penalise" Title="Penalise/Non penalise">
                    <Template Context="data">
                        @if (data.Penalise == 0)
                        {
                            <RadzenBadge Shade="Shade.Light" BadgeStyle="BadgeStyle.Success" Text="Autorise" />
                        }
                        else
                        {
                            <RadzenBadge Shade="Shade.Light" BadgeStyle="BadgeStyle.Danger" Text="Penalise" />
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AdherentDto" Title="Action">
                    <Template Context="data">
                        <RadzenButton Click=@(args => navigationManager.NavigateTo("/adherents/" + data.IdAdherent))
                                      Size="ButtonSize.Small" Shade="Shade.Darker" ButtonStyle="ButtonStyle.Base"
                                      Icon="visibility" Text="View" />
                    </Template>
                </RadzenDataGridColumn>
                
            </Columns>
        </RadzenDataGrid>
    </RadzenColumn>
</RadzenRow>



@code {

    private string SearchText = "";
    
    private IEnumerable<AdherentDto>? adherents;
    private int count;
    private bool isLoading;
    private bool isExporting = false;

    private AdherentsStatsDto? stats;

    private bool _ready = false;
    protected override async Task OnPageInitializedAsync()
    {

        stats = await adherentService.GetStats();
        _ready = true;
        await DoSearch();
    }

    private async Task Export()
    {
        isExporting = true;
        try
        {
            var allData = await adherentService.GetAllAdherentsAsync(SearchText);
            await exportService.ExportToExcelAsync(allData, "Adherents_" + DateTime.Now.ToString("yyyyMMdd_HHmmss"));
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task DoSearch()
    {
        LoadDataArgs args = new LoadDataArgs { };
        await LoadData(args);
    }
    private async Task LoadData(LoadDataArgs args)
    {
        if (!_ready) return;
        isLoading = true;
        try
        {
            int skip = args.Skip ?? 0;
            int top = args.Top ?? 10;

            int pageNumber = (skip / top) + 1;

            var queryParams = new PaginatedQueryParameters
            {
                PageNumber = pageNumber,
                PageSize = top,
                OrderBy = args.OrderBy ?? "datepret desc",
                Search = SearchText
            };

            var result = await adherentService.GetAdherentsAsync(queryParams);

            adherents = result?.Data ?? Enumerable.Empty<AdherentDto>(); // ← null guard
            count = result?.TotalCount ?? 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenCreateModal()
    {
        var positions = await positionService.GetAllPositionsAsync();
        var categories = await categorieService.GetAllCategoriesAsync();
        var model = new Borrowing.SharedClasses.Requests.Adherent.CreateAdherentDto();

        await dialogService.OpenAsync("Ajouter un adhérent", ds =>
            @<RadzenTemplateForm Data="@model"
                                 Submit="@(async (Borrowing.SharedClasses.Requests.Adherent.CreateAdherentDto args) => { await SubmitAdherent(args, ds); })">
                <RadzenStack Gap="1rem" Style="width: 100%; min-width: 400px;">
                    <RadzenFormField Text="Identifiant">
                        <RadzenTextBox @bind-Value="model.IdAdherent" Name="IdAdherent" />
                        <RadzenRequiredValidator Component="IdAdherent" Text="L'identifiant est obligatoire" />
                    </RadzenFormField>
                    <RadzenFormField Text="Nom">
                        <RadzenTextBox @bind-Value="model.Nom" Name="Nom" />
                        <RadzenRequiredValidator Component="Nom" Text="Le nom est obligatoire" />
                    </RadzenFormField>
                    <RadzenFormField Text="Prénom">
                        <RadzenTextBox @bind-Value="model.Prenom" Name="Prenom" />
                        <RadzenRequiredValidator Component="Prenom" Text="Le prénom est obligatoire" />
                    </RadzenFormField>
                    <RadzenFormField Text="Catégorie">
                        <RadzenDropDown @bind-Value="model.IdCategorie" Data="@categories" TextProperty="LibelleCategorie"
                                        ValueProperty="IdCategorie" Name="Categorie" />
                        <RadzenRequiredValidator Component="Categorie" Text="Sélectionnez une catégorie" />
                    </RadzenFormField>
                    <RadzenFormField Text="Position">
                        <RadzenDropDown @bind-Value="model.IdPosition" Data="@positions" TextProperty="LibellePosition"
                                        ValueProperty="IdPosition" Name="Position" />
                        <RadzenRequiredValidator Component="Position" Text="Sélectionnez une position" />
                    </RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                                 class="rz-mt-4">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="Enregistrer" Variant="Variant.Flat" />
                        <RadzenButton Text="Annuler" Variant="Variant.Outlined" Click="() => ds.Close(false)"
                                      ButtonStyle="ButtonStyle.Light" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        );
    }

    private async Task SubmitAdherent(Borrowing.SharedClasses.Requests.Adherent.CreateAdherentDto model, DialogService ds)
    {
        bool success = await adherentService.CreateAdherentAsync(model);
        if (success)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Succès",
                Detail
= "Adhérent créé avec succès",
                Duration = 4000
            });
            ds.Close(true);
            await DoSearch();
        }
        else
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erreur",
                Detail =
"Impossible de créer l'adhérent",
                Duration = 4000
            });
        }
    }
}
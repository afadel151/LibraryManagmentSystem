@page "/penalites"

@inject NavigationManager navigationManager
@inject IPenaliteService penaliteService
@inject ICategorieService categorieService
@inject DialogService dialogService
@inject NotificationService notificationService
@using Borrowing.SharedClasses.Models
@using Borrowing.SharedClasses.Requests.Penalite
@using Borrowing.Web.Services
@using Radzen
@using Radzen.Blazor
@using Common.Models
@using Borrowing.Web.Components.Base
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<Penalites> L

@inherits AuthorizedComponentBase

<RadzenStack class="rz-mt-4" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center">
    <RadzenText TextStyle="TextStyle.H3">@L["Penalties"]</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <RadzenTextBox Placeholder="@L["SearchByCategory"]" style="width:300px" @bind-Value="SearchText"
                       @oninput="DoSearch" Change="DoSearch" />
        <Microsoft.AspNetCore.Components.Authorization.AuthorizeView Roles="ADMIN">
            <RadzenButton Text="@L["Add"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                          Click="OpenCreateModal" />
        </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
    </RadzenStack>
</RadzenStack>

<RadzenRow class="rz-mt-4">
    <RadzenColumn>
        <RadzenDataGrid PagerHorizontalAlign="HorizontalAlign.Justify" Data="@penalites" Count="@count"
                        LoadData="@LoadData" IsLoading="@isLoading" TItem="PenaliteDto" ShowPagingSummary="true"
                        AllowPaging="true" PageSize="10" AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn TItem="PenaliteDto" Property="IdCategorie" Title="@L["Category"]" />
                <RadzenDataGridColumn TItem="PenaliteDto" Property="LibelleCategorie" Title="@L["Label"]" />
                <RadzenDataGridColumn TItem="PenaliteDto" Property="JoursRetard" Title="@L["DaysDelayed"]" />
                <RadzenDataGridColumn TItem="PenaliteDto" Property="NombreJoursRetard" Title="@L["NumberOfDaysDelayed"]" />
                <RadzenDataGridColumn Visible="isAdmin" TItem="PenaliteDto" Title="@L["Actions"]" Width="300px">
                    <Template Context="data">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <AuthorizeView Roles="ADMIN">
                                <Authorized>
                                    <RadzenButton Click=@(args => OpenEditModal(data)) Size="ButtonSize.Small"
                                                  Shade="Shade.Darker" ButtonStyle="ButtonStyle.Primary"
                                                  Icon="edit" Text="@L["Edit"]" />
                                    <RadzenButton Click=@(args => OpenDeleteModal(data)) Size="ButtonSize.Small"
                                                  Shade="Shade.Darker" ButtonStyle="ButtonStyle.Danger"
                                                  Icon="delete" Text="@L["Delete"]" />
                                </Authorized>
                            </AuthorizeView>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenColumn>
</RadzenRow>

@code {
    private string SearchText = "";
    private IEnumerable<PenaliteDto>? penalites;
    private int count;
    private bool isLoading;
    private bool _ready = false;
    private bool isAdmin = false;
    protected override async Task OnPageInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("ADMIN");

        _ready = true;
        await DoSearch();
    }

    private async Task DoSearch()
    {
        LoadDataArgs args = new LoadDataArgs { };
        await LoadData(args);
    }

    private async Task LoadData(LoadDataArgs args)
    {
        if (!_ready) return;
        isLoading = true;
        try
        {
            int skip = args.Skip ?? 0;
            int top = args.Top ?? 10;

            int pageNumber = (skip / top) + 1;

            var queryParams = new PaginatedQueryParameters
            {
                PageNumber = pageNumber,
                PageSize = top,
                OrderBy = args.OrderBy ?? "idcategorie asc",
                Search = SearchText
            };

            var result = await penaliteService.GetPenalitesAsync(queryParams);

            penalites = result?.Data ?? Enumerable.Empty<PenaliteDto>();
            count = result?.TotalCount ?? 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenCreateModal()
    {
        var categories = await categorieService.GetAllCategoriesAsync();
        var model = new CreatePenaliteDto();

        await dialogService.OpenAsync(L["AddPenalty"], ds =>
            @<RadzenTemplateForm Data="@model"
                                 Submit="@(async (CreatePenaliteDto args) => { await SubmitCreate(args, ds); })">
                <RadzenStack Gap="1rem" Style="width: 100%; min-width: 400px;">
                    <RadzenFormField Text="@L["Category"]">
                        <RadzenDropDown @bind-Value="model.IdCategorie" Data="@categories" TextProperty="LibelleCategorie"
                                        ValueProperty="IdCategorie" Name="IdCategorie" />
                        <RadzenRequiredValidator Component="IdCategorie" Text="@L["CategoryIsRequired"]" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["DaysDelayed"]">
                        <RadzenNumeric @bind-Value="model.JoursRetard" Name="JoursRetard" Min="0" Style="width: 100%" />
                        <RadzenRequiredValidator Component="JoursRetard" Text="@L["DaysDelayedIsRequired"]" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["NumberOfDaysDelayed"]">
                        <RadzenNumeric @bind-Value="model.NombreJoursRetard" Name="NombreJoursRetard" Min="0" Style="width: 100%" />
                    </RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                                 class="rz-mt-4">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Variant="Variant.Flat" />
                        <RadzenButton Text="@L["Cancel"]" Variant="Variant.Outlined" Click="() => ds.Close(false)"
                                      ButtonStyle="ButtonStyle.Light" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        );
    }

    private async Task SubmitCreate(CreatePenaliteDto model, DialogService ds)
    {
        bool success = await penaliteService.CreatePenaliteAsync(model);
        if (success)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = L["Success"],
                Detail = L["PenaltyCreatedSuccess"],
                Duration = 4000
            });
            ds.Close(true);
            await DoSearch();
        }
        else
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = L["Error"],
                Detail = L["ErrorCreatingPenalty"],
                Duration = 4000
            });
        }
    }

    private async Task OpenEditModal(PenaliteDto data)
    {
        var categories = await categorieService.GetAllCategoriesAsync();
        var model = new UpdatePenaliteDto
        {
            IdCategorie = data.IdCategorie,
            JoursRetard = data.JoursRetard,
            NombreJoursRetard = data.NombreJoursRetard
        };

        await dialogService.OpenAsync(L["EditPenalty"], ds =>
            @<RadzenTemplateForm Data="@model"
                                 Submit="@(async (UpdatePenaliteDto args) => { await SubmitEdit(args, ds); })">
                <RadzenStack Gap="1rem" Style="width: 100%; min-width: 400px;">
                    <RadzenFormField Text="@L["Category"]">
                        <RadzenDropDown @bind-Value="model.IdCategorie" Data="@categories" TextProperty="LibelleCategorie"
                                        ValueProperty="IdCategorie" Name="IdCategorie" Disabled="true" />
                        <RadzenRequiredValidator Component="IdCategorie" Text="@L["CategoryIsRequired"]" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["DaysDelayed"]">
                        <RadzenNumeric @bind-Value="model.JoursRetard" Name="JoursRetard" Min="0" Style="width: 100%" />
                        <RadzenRequiredValidator Component="JoursRetard" Text="@L["DaysDelayedIsRequired"]" />
                    </RadzenFormField>
                    <RadzenFormField Text="@L["NumberOfDaysDelayed"]">
                        <RadzenNumeric @bind-Value="model.NombreJoursRetard" Name="NombreJoursRetard" Min="0" Style="width: 100%" />
                    </RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                                 class="rz-mt-4">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Update"]" Variant="Variant.Flat" />
                        <RadzenButton Text="@L["Cancel"]" Variant="Variant.Outlined" Click="() => ds.Close(false)"
                                      ButtonStyle="ButtonStyle.Light" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        );
    }

    private async Task SubmitEdit(UpdatePenaliteDto model, DialogService ds)
    {
        bool success = await penaliteService.UpdatePenaliteAsync(model);
        if (success)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = L["Success"],
                Detail = L["PenaltyUpdatedSuccess"],
                Duration = 4000
            });
            ds.Close(true);
            await DoSearch();
        }
        else
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = L["Error"],
                Detail = L["ErrorUpdatingPenalty"],
                Duration = 4000
            });
        }
    }

    private async Task OpenDeleteModal(PenaliteDto data)
    {
        var result = await dialogService.Confirm(L["ConfirmDeletePenalty"], L["DeleteConfirmation"], new ConfirmOptions() { OkButtonText = L["Yes"], CancelButtonText = L["No"] });

        if (result == true)
        {
            await DeletePenalite(data);
        }
    }

    private async Task DeletePenalite(PenaliteDto data)
    {
        bool success = await penaliteService.DeletePenaliteAsync(data.IdCategorie);
        if (success)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = L["Success"],
                Detail = L["PenaltyDeletedSuccess"],
                Duration = 4000
            });
            await DoSearch();
        }
        else
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = L["Error"],
                Detail = L["ErrorDeletingPenalty"],
                Duration = 4000
            });
        }
    }
}
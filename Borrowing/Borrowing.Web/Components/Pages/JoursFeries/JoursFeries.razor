@page "/jours_feries"
@inject NavigationManager navigationManager

@inject IJoursFeriesService joursFeriesService

@inject IExportService exportService
@inject DialogService dialogService
@inject NotificationService notificationService
@using Borrowing.SharedClasses.Models
@using Borrowing.SharedClasses.Requests.JoursFery
@using Borrowing.Web.Services
@using Radzen
@using Radzen.Blazor
@using Common.Models
@using Borrowing.Web.Components.Base
@using System.Globalization
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<JoursFeries> L

@inherits AuthorizedComponentBase

<RadzenStack class="rz-mt-4" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center">
    <RadzenText TextStyle="TextStyle.H3">@L["Holidays"]</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <RadzenTextBox Placeholder="@L["SearchByDate"]" style="width:300px" @bind-Value="SearchText"
                       @oninput="DoSearch" Change="DoSearch" />
        
        <Microsoft.AspNetCore.Components.Authorization.AuthorizeView Roles="ADMIN">
            <RadzenButton Text="@L["Add"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat"
                          Click="OpenCreateModal" />
        </Microsoft.AspNetCore.Components.Authorization.AuthorizeView>
    </RadzenStack>
</RadzenStack>

<RadzenRow class="rz-mt-4" >
    <RadzenColumn>
        <RadzenDataGrid  PagerHorizontalAlign="HorizontalAlign.Justify" Data="@joursFeries" Count="@count"
                        LoadData="@LoadData" IsLoading="@isLoading" TItem="JoursFeryDto" ShowPagingSummary="true"
                        AllowPaging="true" PageSize="10" AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn TItem="JoursFeryDto" Property="DateJourFerie" Title="@L["Date"]" FormatString="{0:dd/MM/yyyy}" />
                <RadzenDataGridColumn Visible="isAdmin" TItem="JoursFeryDto" Title="@L["Actions"]" Width="200px">
                    <Template Context="data">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <AuthorizeView Roles="ADMIN">
                                <Authorized>
                                    <RadzenButton Click=@(args => OpenDeleteModal(data)) Size="ButtonSize.Small" 
                                                  Shade="Shade.Darker" ButtonStyle="ButtonStyle.Danger"
                                                  Icon="delete" Text="@L["Delete"]" />
                                </Authorized>
                            </AuthorizeView>
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenColumn>
</RadzenRow>

@code {
    private string SearchText = "";
    private IEnumerable<JoursFeryDto>? joursFeries;
    private int count;
    private bool isLoading;
    private bool isAdmin;
    private bool isExporting = false;
    private bool _ready = false;

    protected override async Task OnPageInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        isAdmin = authState.User.IsInRole("ADMIN");
        _ready = true;
        await DoSearch();
    }

    private async Task Export()
    {
        isExporting = true;
        try
        {
            var allData = await joursFeriesService.GetAllJoursFeriesAsync();
            await exportService.ExportToExcelAsync(allData, "JoursFeries_" + DateTime.Now.ToString("yyyyMMdd_HHmmss"));
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task DoSearch()
    {
        LoadDataArgs args = new LoadDataArgs { };
        await LoadData(args);
    }

    private async Task LoadData(LoadDataArgs args)
    {
        if (!_ready) return;
        isLoading = true;
        try
        {
            int skip = args.Skip ?? 0;
            int top = args.Top ?? 10;

            int pageNumber = (skip / top) + 1;

            var queryParams = new PaginatedQueryParameters
            {
                PageNumber = pageNumber,
                PageSize = top,
                OrderBy = args.OrderBy ?? "datejourferie desc",
                Search = SearchText
            };

            var result = await joursFeriesService.GetJoursFeriesAsync(queryParams);

            joursFeries = result?.Data ?? Enumerable.Empty<JoursFeryDto>();
            count = result?.TotalCount ?? 0;
        }
        finally
        {
            isLoading = false;
        }
    }
    
    private async Task OpenCreateModal()
    {
        var model = new CreateJoursFeryDto();
        // add Notification about 
        await dialogService.OpenAsync(L["AddHoliday"], ds =>
            @<RadzenTemplateForm Data="@model"
                                 Submit="@(async (CreateJoursFeryDto args) => { await SubmitCreate(args, ds); })">
                <RadzenStack Gap="1rem" Style="width: 100%; min-width: 400px;">
                    <RadzenFormField Text="@L["HolidayDate"]">
                        <RadzenDatePicker  Culture="@CultureInfo.CurrentCulture" DateFormat="yyyy/MM/dd"  @bind-Value="model.DateJourFerie" Name="DateJourFerie" />
                        <RadzenRequiredValidator Component="DateJourFerie" Text="@L["DateRequired"]" />
                    </RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem"
                                 class="rz-mt-4">
                        <RadzenButton ButtonType="ButtonType.Submit" Text="@L["Save"]" Variant="Variant.Flat" />
                        <RadzenButton Text="@L["Cancel"]" Variant="Variant.Outlined" Click="() => ds.Close(false)"
                                      ButtonStyle="ButtonStyle.Light" />
                    </RadzenStack>
                </RadzenStack>
            </RadzenTemplateForm>
        );
    }

    private async Task SubmitCreate(CreateJoursFeryDto model, DialogService ds)
    {
        bool success = await joursFeriesService.CreateJoursFeryAsync(model);
        if (success)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = L["Success"],
                Detail = L["HolidayCreatedSuccess"],
                Duration = 4000
            });
            ds.Close(true);
            await DoSearch();
        }
        else
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = L["Error"],
                Detail = L["ErrorCreatingHoliday"],
                Duration = 4000
            });
        }
    }

    private async Task OpenDeleteModal(JoursFeryDto data)
    {
        var result = await dialogService.Confirm(L["ConfirmDeleteHoliday"], L["DeleteConfirmation"],
            new ConfirmOptions() { OkButtonText = L["Yes"], CancelButtonText = L["No"] });

        if (result == true)
        {
            await DeleteJoursFery(data);
        }
    }

    private async Task DeleteJoursFery(JoursFeryDto data)
    {
        bool success = await joursFeriesService.DeleteJoursFeryAsync(data.DateJourFerie);
        if (success)
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = L["Success"],
                Detail = L["HolidayDeletedSuccess"],
                Duration = 4000
            });
            await DoSearch();
        }
        else
        {
            notificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = L["Error"],
                Detail = L["ErrorDeletingHoliday"],
                Duration = 4000
            });
        }
    }
} 
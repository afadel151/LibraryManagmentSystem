@page "/restitutions"
@using Borrowing.SharedClasses.Responses.Adherent
@using Borrowing.Web.Components.Base
@using Borrowing.Web.Services
@using Borrowing.SharedClasses.Common
@using Borrowing.SharedClasses.Requests.Restitution
@using Microsoft.Extensions.Localization

@inject IRestitutionService restitutionService
@inject NotificationService NotificationService

@inject IStringLocalizer<Restitutions> L

@inherits AuthorizedComponentBase



<RadzenText TextStyle="TextStyle.H2">@L["MakeRestitution"]</RadzenText>

<RadzenCard Variant="Variant.Filled" Style="height: 100%;margin-top:2rem;">
    <RadzenText TextStyle="TextStyle.H3">@L["AdherentInformation"]</RadzenText>

    <RadzenStack Orientation="Orientation.Vertical" Gap="2rem" class="rz-mt-3">
        <RadzenTextBox Placeholder="@L["EnterAdherentId"]" @bind-Value="AdherentId" @oninput="OnMemberTyping"
                       Change="OnMemberIdChanged" class="w-100" />

        @if (isLoadingMember)
        {
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
        }
        else if (hasSearchedMember && adherentCheck != null)
        {
            <RadzenRow>
                <RadzenColumn Size="4">
                    <img src="@(adherentCheck.Picture)" style="width: 50%; border-radius: 8px;"
                         onerror="this.style.display='none'" />
                </RadzenColumn>
                <RadzenColumn Size="8">

                    <RadzenText TextStyle="TextStyle.DisplayH5"><b>@(adherentCheck.Adherent?.Nom?.ToUpper())

                        @adherentCheck.Adherent?.Prenom</b></RadzenText>
                        <RadzenText TextStyle="TextStyle.DisplayH6">@L["Category"]:
                            @adherentCheck.Adherent?.Categorie?.LibelleCategorie
                        </RadzenText>

                       
                        <RadzenBadge  Style="scale: 150% 150%;margin-left:10px;margin-top:10px;"
                                     BadgeStyle="@(adherentCheck.Adherent!.EtatAdherent == 1 ? BadgeStyle.Success : BadgeStyle.Danger)"
                                     Text="@(adherentCheck.Adherent!.EtatAdherent == 1 ? @L["Active"] : adherentCheck.Adherent!.EtatAdherent == 2 ?  @L["Penalised"] : @L["Suspended"])" />

                            
                        <div class="rz-mt-5">
                            <RadzenText  TextStyle="TextStyle.DisplayH6">@L["Quota"]: @adherentCheck.Adherent!.Prets.Count /
                                @adherentCheck.Adherent?.Categorie?.NombreDocument</RadzenText>
                                                
                               
                            </div>
                            <RadzenText TextStyle="TextStyle.H6" class="rz-mt-3">@L["SelectExemplaire"] :</RadzenText>
                            <RadzenDropDown @bind-Value="selectedCopyId"
                                            Data="@adherentCheck.Adherent!.Prets.Select(p=>p.IdExemplaire)"
                                            Style="width: 600px;font-weight:bold;" />
                                
                        </RadzenColumn>
                    </RadzenRow>
                }
                else if (hasSearchedMember && adherentCheck == null)
                {
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-color-danger">@L["AdherentNotFound"].</RadzenText>
                }
            </RadzenStack>
        </RadzenCard>
        <RadzenRow class="rz-mt-4" JustifyContent="JustifyContent.End">
            @if (adherentCheck != null)
            {
                    
                @if (selectedCopyId != null)
                {

                    <RadzenButton Text="@L["ValidateRestitution"]" Click="ValiderRestitution" ButtonStyle="ButtonStyle.Success"
                                  Size="ButtonSize.Medium" class="rz-mr-2" />
                    @if (adherentCheck.Adherent!.PenaliteAdherents.Count == 0 && adherentCheck.Adherent.EtatAdherent == 1)
                    {
                        <RadzenButton Text="@L["RenewLoan"]" Click="ValiderRenouvlement" ButtonStyle="ButtonStyle.Info"
                                      Size="ButtonSize.Medium" class="rz-mr-2" />
                    }
                }

            }
        </RadzenRow>

@code {

    string AdherentId = "";
    string? selectedCopyId;

    CheckAdhRestitutionResponseDto? adherentCheck;
    bool isLoadingMember = false;
    bool hasSearchedMember = false;

    void OnMemberTyping(ChangeEventArgs e)
    {
        ResetMemberState();
    }
    private async Task OnMemberIdChanged()
    {
        if (string.IsNullOrWhiteSpace(AdherentId))
        {
            ResetMemberState();
            return;
        }
        isLoadingMember = true;
        string searchId = AdherentId.Trim().ToUpper();
        adherentCheck = await restitutionService.CheckAdherent(searchId);
        hasSearchedMember = true;
        StateHasChanged();
        if (adherentCheck == null)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Detail =
                    @L["ErrorVerifyingAdherent"],
                Duration = 4000
            });
            ResetMemberState();
        }
        isLoadingMember = false;
    }

    private async Task ValiderRestitution()
    {
        if (string.IsNullOrEmpty(selectedCopyId))
            return;
        if (adherentCheck == null)
            return;


        CreateRestitutionDto dto = new()
        {
            AdherentId = adherentCheck!.Adherent!.IdAdherent,
            ExemplaireId = selectedCopyId!
        };

        var success = await restitutionService.ValiderRestitution(dto);
        if (success)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = @L["RestitutionValid"],
                Duration = 4000
            });
            ResetMemberState();
        }
        else
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = @L["ErrorDuringRestitution"],
                Duration = 4000
            });
        }


    }

    private async Task ValiderRenouvlement()
    {
        if (string.IsNullOrEmpty(selectedCopyId))
            return;
        if (adherentCheck == null)
            return;


        CreateRestitutionDto dto = new()
        {
            AdherentId = adherentCheck!.Adherent!.IdAdherent,
            ExemplaireId = selectedCopyId!
        };

        var success = await restitutionService.ValiderRenouvlement(dto);
        if (success)
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Success,
                Summary = "Restitution Valide",
                Duration = 4000
            });
            ResetMemberState();
        }
        else
        {
            ShowNotification(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = @L["ErrorDuringRenewal"],
                Duration = 4000
            });
        }


    }

    private void ResetMemberState()
    {

        adherentCheck = null;
        hasSearchedMember = false;
    }
    void ShowNotification(NotificationMessage message)
    {
        NotificationService.Notify(message);
    }
}
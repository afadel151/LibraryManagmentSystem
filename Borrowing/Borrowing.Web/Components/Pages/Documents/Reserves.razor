@page "/documents/reservees"
@using Borrowing.Web.Extensions
@using Borrowing.Web.Services
@using Borrowing.SharedClasses.Models
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Reserves> L
@inject IReservationService _reservationService
@inject NavigationManager navigationManager
@inject IExportService exportService
@inject DialogService dialogService
@inject NotificationService notificationService

<RadzenStack class="rz-mt-4" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center">
    <RadzenText TextStyle="TextStyle.H3">@L["Reservations"]</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <RadzenTextBox Placeholder="@L["SearchByIdOrName"]" style="width:400px" @bind-Value="SearchText"
                       @oninput="DoSearch" Change="DoSearch" />
        <RadzenButton Text="@(isExporting ? L["Exporting"] : L["Export"])" Icon="get_app" Click="Export" ButtonStyle="ButtonStyle.Base"
                      Variant="Variant.Flat" />
    </RadzenStack>
</RadzenStack>

<RadzenRow class="rz-mt-4">
    <RadzenColumn>
        <RadzenDataGrid PagerHorizontalAlign="HorizontalAlign.Justify" Data="@reservations" Count="@count" LoadData="@LoadData"
                        IsLoading="@isLoading" TItem="ReservationDto" ShowPagingSummary="true" AllowPaging="true" PageSize="10"
                        AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn Property="IdAdherent" Title="@L["AdherentId"]" Width="130px" />
                <RadzenDataGridColumn Property="Nom" Title="@L["Adherent"]">
                    <Template Context="data">
                        @($"{data.Nom} {data.Prenom}")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Property="TitrePropre" Title="@L["Title"]" />
                <RadzenDataGridColumn Property="Cote" Title="@L["Cote"]" Width="150px" />
                <RadzenDataGridColumn Property="HeureReservation" Title="@L["ReservationDate"]" FormatString="{0:dd/MM/yyyy HH:mm}">
                    <Template Context="data">
                        @data.HeureReservation
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="@L["Actions"]" Sortable="false" Filterable="false" >
                    <Template Context="data">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Click=@(args => navigationManager.NavigateTo($"/adherents/{data.IdAdherent}"))
                                          Size="ButtonSize.Small" Icon="person" Text="@L["Adherent"]"
                                          ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Flat" />
                            <RadzenButton Click=@(args => ConfirmDelete(data))
                                          Size="ButtonSize.Small" Icon="delete" Text="@L["Delete"]"
                                          ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat" />
                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenColumn>
</RadzenRow>

@code {
    private IEnumerable<ReservationDto>? reservations;
    private int count;
    private bool isLoading;
    private string SearchText = "";
    private bool isExporting = false;

    private async Task DoSearch()
    {
        LoadDataArgs args = new LoadDataArgs { };
        await LoadData(args);
    }

    private async Task Export()
    {
        isExporting = true;
        try
        {
            var allData = await _reservationService.GetAllReservationsAsync(SearchText);
            await exportService.ExportToExcelAsync(allData, $"{L["Reservations"]}_{DateTime.Now.ToString("yyyyMMdd_HHmmss")}");
        }
        finally
        {
            isExporting = false;
        }
    }

    async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;

        try
        {
            var queryParams = new PaginatedQueryParameters
            {
                PageNumber = (args.Skip ?? 0) / (args.Top ?? 10) + 1,
                PageSize = args.Top ?? 10,
                OrderBy = args.OrderBy ?? "HeureReservation desc",
                Search = SearchText
            };

            var result = await _reservationService.GetReservationsAsync(queryParams);
            reservations = result.Data;
            count = result.TotalCount;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmDelete(ReservationDto data)
    {
        var result = await dialogService.Confirm($"{L["ConfirmDelete"]}{data.Nom} {data.Prenom} pour '{data.TitrePropre}' ?", L["Confirmation"], new ConfirmOptions() { OkButtonText = L["Yes"], CancelButtonText = L["No"] });

        if (result == true)
        {
            await DeleteReservation(data);
        }
    }

    private async Task DeleteReservation(ReservationDto data)
    {
        isLoading = true;
        try
        {
            var success = await _reservationService.DeleteReservationAsync(data.IdAdherent, data.Cote, data.HeureReservation);
            if (success)
            {
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = L["Success"],
                    Detail = L["ReservationDeletedSuccess"],
                    Duration = 4000
                });
                await DoSearch();
            }
            else
            {
                notificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = L["Error"],
                    Detail = L["ErrorDeletingReservation"],
                    Duration = 4000
                });
            }
        }
        finally
        {
            isLoading = false;
        }
    }
}
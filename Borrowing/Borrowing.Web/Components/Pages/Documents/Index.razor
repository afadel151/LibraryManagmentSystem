@page "/documents"
@using Borrowing.Web.Services
@using Borrowing.Web.Components.Base
@using Borrowing.SharedClasses.Models
@using Microsoft.Extensions.Localization

@inject NavigationManager navigationManager
@inject INoticeService noticeService
@inject IStringLocalizer<Index> L



@inject IExportService exportService

@inherits AuthorizedComponentBase

<RadzenStack class="rz-mt-4" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween"
             AlignItems="AlignItems.Center">
    <RadzenText TextStyle="TextStyle.H3">@L["TotalDocuments"]</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
        <RadzenTextBox Placeholder="@L["SearchByCoteOrTitle"]" style="width:400px" @bind-Value="SearchText"
                       @oninput="DoSearch" Change="DoSearch" />
        <RadzenButton Text="@(isExporting ? L["Exporting"] : L["Export"])" Icon="get_app" Click="Export" ButtonStyle="ButtonStyle.Base"
                      Variant="Variant.Flat" />
    </RadzenStack>
</RadzenStack>
<RadzenRow class="rz-mt-4">
    <RadzenColumn>
        <RadzenDataGrid PagerHorizontalAlign="HorizontalAlign.Justify" Data="@notices" Count="@count"
                        LoadData="@LoadData" IsLoading="@isLoading" TItem="NoticeDto" ShowPagingSummary="true" AllowPaging="true"
                        PageSize="10" AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn TItem="NoticeDto" Property="Cote" Title="@L["Cote"]" Width="130px" />
                <RadzenDataGridColumn TItem="NoticeDto"  Property="TitrePropre" Title="@L["Title"]" />
                <RadzenDataGridColumn TItem="NoticeDto"  Property="TypeNotice1" Title="@L["Type"]" />
                <RadzenDataGridColumn TItem="NoticeDto"  Property="ExemplaireDispo" Title="@L["AvailableCopies"]" />
                <RadzenDataGridColumn TItem="NoticeDto"  Property="ExemplaireEnPret" Title="@L["CopiesOnLoan"]" />
                <RadzenDataGridColumn TItem="NoticeDto"  Property="Reservations" Title="@L["ActiveReservations"]" />
                <RadzenDataGridColumn TItem="NoticeDto"  Property="CopiesBloques" Title="@L["BlockedCopies"]" />
                <RadzenDataGridColumn TItem="NoticeDto" Title="@L["Action"]">
                    <Template Context="data">
                        <RadzenButton Click=@(args => navigationManager.NavigateTo($"/documents/{data.IdNotice}")) Size="ButtonSize.Small" Icon="visibility" Text="@L["View"]" />
                    </Template>
                </RadzenDataGridColumn>
                
            </Columns>
        </RadzenDataGrid>
    </RadzenColumn>
</RadzenRow>
<RadzenCard class="rz-mt-4">
    <RadzenText TextStyle="TextStyle.H6" Text="@L["MostBorrowedDocuments"]" />  

    @if (topLoaned == null)
    {
        <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else
    {
        <RadzenChart Style="height: 400px;">

            <RadzenLegend Visible="false" />
            <RadzenColumnSeries Data="@topLoaned" CategoryProperty="TitrePropre" ValueProperty="TotalPrets"
                                Title="@L["NumberOfLoans"]" Fill="var(--rz-primary)">
                <TooltipTemplate Context="data">
                    <div>
                        Document <span>@data.Cote</span> <br>
                        @data.TitrePropre <br>
                        <strong>@data.TotalPrets</strong> prets
                    </div>
                </TooltipTemplate>
            </RadzenColumnSeries>

            <RadzenCategoryAxis LabelAutoRotation="-10">
                <RadzenAxisTitle Text="@L["Document"]" />
                <RadzenTicks>
                </RadzenTicks>
                <RadzenGridLines Visible="true" />
            </RadzenCategoryAxis>

            <RadzenValueAxis>
                <RadzenAxisTitle Text="@L["TotalNumberOfLoans"]" />
                <RadzenGridLines Visible="true" />
            </RadzenValueAxis>


        </RadzenChart>
    }
</RadzenCard>
@code {
    private List<TopLoanedNoticeDto>? topLoaned;
    private string SearchText = "";
    
    private IEnumerable<NoticeDto>? notices;
    private int count;
    private bool isLoading;
    private bool isExporting = false;

    private async Task Export()
    {
        isExporting = true;
        try
        {
            var allData = await noticeService.GetAllNoticesAsync(SearchText);
            await exportService.ExportToExcelAsync(allData, "Documents_" + DateTime.Now.ToString("yyyyMMdd_HHmmss"));
        }
        finally
        {
            isExporting = false;
        }
    }


    protected override async Task OnPageInitializedAsync()
    {
        topLoaned = await noticeService.GetChartData();
    }
    private async Task DoSearch()
    {
        LoadDataArgs args = new LoadDataArgs { };
        await LoadData(args);
    }
    private async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;

        try
        {
            int skip = args.Skip ?? 0;
            int top = args.Top ?? 10;

            int pageNumber = (skip / top) + 1;

            var queryParams = new PaginatedQueryParameters
            {
                PageNumber = pageNumber,
                PageSize = top,
                OrderBy = args.OrderBy ?? "datepret desc",
                Search = SearchText
            };

            var result = await noticeService.GetNoticesAsync(queryParams);

            notices = result.Data;
            count = result.TotalCount;
        }
        finally
        {
            isLoading = false;
        }
    }
}
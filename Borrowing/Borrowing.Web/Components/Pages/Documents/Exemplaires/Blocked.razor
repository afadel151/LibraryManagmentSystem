@page "/exemplaire/bloques"


@using Borrowing.Web.Services
@using Borrowing.Web.Components.Base

@using Microsoft.Extensions.Localization
@using Common.Models
@using Borrowing.SharedClasses.Models
@inject IExemplaireService exemplaireService
@inject IStringLocalizer<Blocked> L
@inject NavigationManager navigationManager
@inject IExportService exportService

@inherits AuthorizedComponentBase



<RadzenText TextStyle="TextStyle.H3">@L["BlockedExemplaires"]</RadzenText>

<RadzenRow class="rz-mt-4">
    <RadzenColumn>
        <RadzenDataGrid PagerHorizontalAlign="HorizontalAlign.Justify" Data="@exemplaireBloques" Count="@count"
                        LoadData="@LoadData" IsLoading="@isLoading" TItem="ExemplaireBloqueDto" ShowPagingSummary="true"
                        AllowPaging="true" PageSize="10" AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn Property="IdExemplaire" Title="@L["ExemplaireId"]" />
                <RadzenDataGridColumn TItem="ExemplaireBloqueDto" Property="TitrePropre" Title="@L["Title"]" />
                <RadzenDataGridColumn TItem="ExemplaireBloqueDto" Property="DatePret" Title="@L["ReturnDate"]">
                    <Template Context="data">
                        @data.DatePret.ToString("dd/MM/yyyy")
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn Title="@L["Actions"]"  Filterable="false" Sortable="false" 
                                      Width="300px">
                    <Template Context="data">
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Click=@(args => navigationManager.NavigateTo($"/exemplaires/{data.IdExemplaire}")) Size="ButtonSize.Small" Icon="visibility" Text="@L["Exemplaire"]"
                                          ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Flat" />

                            <RadzenButton Click=@(args => navigationManager.NavigateTo($"/documents/{data.IdNotice}")) Size="ButtonSize.Small" Icon="menu_book" Text="@L["Document"]"
                                          ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Flat" />

                        </RadzenStack>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </RadzenColumn>
</RadzenRow>




@code {

    IEnumerable<ExemplaireBloqueDto> exemplaireBloques = [];
    
    private int count;
    private bool isLoading;
    private bool isExporting = false;

    protected override async Task OnPageInitializedAsync()
    {
        
        LoadDataArgs args = new LoadDataArgs { };
        await LoadData(args);
    }
    private async Task LoadData(LoadDataArgs args)
    {
        isLoading = true;
        try
        {
            int skip = args.Skip ?? 0;
            int top = args.Top ?? 10;

            int pageNumber = (skip / top) + 1;

            var queryParams = new PaginatedQueryParameters
            {
                PageNumber = pageNumber,
                PageSize = top,
                OrderBy = args.OrderBy ?? "datepret desc",
            };

            var result = await exemplaireService.GetExemplaireBloquesAsync(queryParams);

            exemplaireBloques = result?.Data ?? Enumerable.Empty<ExemplaireBloqueDto>();
            count = result?.TotalCount ?? 0;
        }
        finally
        {
            isLoading = false;
        }
    }

}
@rendermode InteractiveAuto
 <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@(() => sidebarExpanded = !sidebarExpanded)" />
            <RadzenLabel Text="CATlib-PRET" />
        </RadzenStack>
    </RadzenHeader>

<RadzenSidebar Position="SidebarPosition.Left" FullHeight="true" Responsive=false  @bind-Expanded="@sidebarExpanded">
    
    <RadzenPanelMenu DisplayStyle="@(sidebarExpanded ? MenuItemDisplayStyle.IconAndText : MenuItemDisplayStyle.Icon)">
        <RadzenPanelMenuItem Text="Menu" Icon="apps" Path="/" />
        <RadzenPanelMenuItem Text="Gestion des Prets" Icon="hand_package" Path="/prets" />
        <RadzenPanelMenuItem Text="Gestion des Adherents" Icon="person" Path="/adherents" />
        <RadzenPanelMenuItem Text="Gestion des Restitutions" Icon="source_notes" Path="/restitutions" />
        <RadzenPanelMenuItem Text="Gestion des Documents" Icon="article" Path="/documents" >
            <RadzenPanelMenuItem Text="Tous les documents" Icon="newsstand" Path="/documents" />
            <RadzenPanelMenuItem Text="Documents en pret" Icon="assignment_turned_in" Path="/documents/en_pret" />
            <RadzenPanelMenuItem Text="Documents Reservees" Icon="date_range" Path="/documents/reservees"/>
        </RadzenPanelMenuItem>
        <RadzenPanelMenuItem Text="Avis de Disponibilite" Icon="timelapse" Path="/availability" />
        <RadzenPanelMenuItem Text="Gestion des relances" Icon="notifications_active" Path="/relances" />
        <RadzenPanelMenuItem Text="Gestion des categories" Icon="category" Path="/categories" />
        
    </RadzenPanelMenu>
</RadzenSidebar>
@code {
    bool sidebarExpanded = true;
}
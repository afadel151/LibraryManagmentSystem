@{
    ViewData["Title"] = "CATLIB_DATA — Catalogue de la bibliothèque";
    Layout = "_LayoutGuest";
}

@section Scripts {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy:  { DEFAULT: '#0f1e35', light: '#192d4d', subtle: '#e8edf3' },
                        gold:  { DEFAULT: '#b8952a', light: '#d4ad3a', muted: '#f5edda' },
                        stone: { DEFAULT: '#6b6458', light: '#9c9187' },
                    },
                    fontFamily: {
                        serif: ['"EB Garamond"', 'Georgia', 'serif'],
                        sans:  ['"DM Sans"', 'system-ui', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style>
        body { font-family: 'DM Sans', system-ui, sans-serif; background: #f4f1ec; }

        .hero-bg {
            background-color: #0f1e35;
            background-image:
                repeating-linear-gradient(0deg,   transparent, transparent 39px, rgba(184,149,42,.07) 39px, rgba(184,149,42,.07) 40px),
                repeating-linear-gradient(90deg,  transparent, transparent 39px, rgba(184,149,42,.07) 39px, rgba(184,149,42,.07) 40px);
        }

        .gold-rule { background: linear-gradient(90deg, transparent, #b8952a 20%, #b8952a 80%, transparent); height: 1px; }

        .stat-card {
            background: #fff;
            border: 1px solid #e2ddd6;
            border-top: 3px solid #b8952a;
            transition: box-shadow .2s, transform .2s;
        }
        .stat-card:hover { box-shadow: 0 8px 24px rgba(15,30,53,.12); transform: translateY(-2px); }

        .module-card {
            background: #fff;
            border: 1px solid #e2ddd6;
            transition: box-shadow .2s, border-color .2s;
        }
        .module-card:hover { border-color: #b8952a; box-shadow: 0 4px 20px rgba(15,30,53,.1); }

        .module-icon {
            width: 44px; height: 44px;
            background: #f5edda;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
        }

        .tag {
            display: inline-block;
            font-size: .68rem;
            font-weight: 500;
            letter-spacing: .08em;
            text-transform: uppercase;
            padding: 3px 10px;
            border-radius: 2px;
            background: #f5edda;
            color: #b8952a;
            border: 1px solid #e8dcc0;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-up { animation: fadeUp .6s ease both; }
        .delay-1 { animation-delay: .1s; }
        .delay-2 { animation-delay: .2s; }
        .delay-3 { animation-delay: .3s; }
        .delay-4 { animation-delay: .4s; }
    </style>
}

<div class="min-h-screen -mt-3" style="background:#f4f1ec;">

    <section class="hero-bg py-20 px-6">
        <div class="max-w-4xl mx-auto text-center fade-up">
            <span class="tag mb-6 inline-block" style="background:rgba(184,149,42,.15);border-color:rgba(184,149,42,.35);color:#d4ad3a;">
                Système de gestion documentaire
            </span>

            <h1 class="font-serif text-5xl md:text-6xl text-white font-normal leading-tight mt-4 mb-2">
                CATLIB<span style="color:#b8952a;">_DATA</span>
            </h1>
            <p class="font-serif text-lg text-blue-100/70 italic mb-8">
                Catalogue et inventaire de la bibliothèque institutionnelle
            </p>

            <div class="gold-rule max-w-xs mx-auto mb-8"></div>

            <p class="font-sans text-sm text-slate-300/70 max-w-xl mx-auto leading-relaxed mb-10">
                Plateforme centralisée de gestion des collections, du catalogage bibliographique,
                des acquisitions et du suivi des exemplaires physiques et numériques.
            </p>

            <div class="flex flex-wrap gap-3 justify-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Catalogue" asp-action="Index"
                       class="btn font-sans font-medium px-8"
                       style="background:#b8952a;border:none;color:#fff;border-radius:4px;">
                        Féder au catalogue
                    </a>
                    <a asp-controller="Exemplaire" asp-action="Index"
                       class="btn btn-outline font-sans font-medium px-8"
                       style="border-color:rgba(255,255,255,.3);color:#fff;border-radius:4px;">
                        Gestion des exemplaires
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login"
                       class="btn font-sans font-medium px-10"
                       style="background:#b8952a;border:none;color:#fff;border-radius:4px;letter-spacing:.03em;">
                        Se connecter
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="max-w-5xl mx-auto px-6 -mt-8 relative z-10">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">

            <div class="stat-card rounded p-5 fade-up delay-1">
                <p class="font-sans text-xs text-stone-light uppercase tracking-widest mb-1">Titres catalogués</p>
                <p class="font-serif text-3xl text-navy">—</p>
            </div>
            <div class="stat-card rounded p-5 fade-up delay-2">
                <p class="font-sans text-xs text-stone-light uppercase tracking-widest mb-1">Exemplaires</p>
                <p class="font-serif text-3xl text-navy">—</p>
            </div>
            <div class="stat-card rounded p-5 fade-up delay-3">
                <p class="font-sans text-xs text-stone-light uppercase tracking-widest mb-1">Auteurs référencés</p>
                <p class="font-serif text-3xl text-navy">—</p>
            </div>
            <div class="stat-card rounded p-5 fade-up delay-4">
                <p class="font-sans text-xs text-stone-light uppercase tracking-widest mb-1">Collections</p>
                <p class="font-serif text-3xl text-navy">—</p>
            </div>

        </div>
    </section>

    <section class="max-w-5xl mx-auto px-6 py-16">

        <div class="flex items-center gap-4 mb-10 fade-up">
            <div class="gold-rule flex-1"></div>
            <h2 class="font-serif text-2xl text-navy font-normal whitespace-nowrap">Modules du système</h2>
            <div class="gold-rule flex-1"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

            <div class="module-card rounded p-6 fade-up delay-1">
                <div class="module-icon mb-4">
                    <svg width="22" height="22" fill="none" stroke="#b8952a" stroke-width="1.6" viewBox="0 0 24 24">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                    </svg>
                </div>
                <h3 class="font-serif text-lg text-navy mb-2">Catalogage</h3>
                <p class="font-sans text-sm text-stone leading-relaxed mb-4">
                    Enregistrement et description bibliographique des ouvrages selon les normes ISBD et MARC21.
                </p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Catalogue" asp-action="Index"
                       class="font-sans text-xs font-medium" style="color:#b8952a;">
                        Accéder →
                    </a>
                }
            </div>

            <div class="module-card rounded p-6 fade-up delay-2">
                <div class="module-icon mb-4">
                    <svg width="22" height="22" fill="none" stroke="#b8952a" stroke-width="1.6" viewBox="0 0 24 24">
                        <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                        <line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/>
                    </svg>
                </div>
                <h3 class="font-serif text-lg text-navy mb-2">Acquisitions</h3>
                <p class="font-sans text-sm text-stone leading-relaxed mb-4">
                    Suivi des commandes, réceptions et intégration des nouvelles acquisitions au fonds documentaire.
                </p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Acquisition" asp-action="Index"
                       class="font-sans text-xs font-medium" style="color:#b8952a;">
                        Accéder →
                    </a>
                }
            </div>

            <div class="module-card rounded p-6 fade-up delay-3">
                <div class="module-icon mb-4">
                    <svg width="22" height="22" fill="none" stroke="#b8952a" stroke-width="1.6" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
                <h3 class="font-serif text-lg text-navy mb-2">Recherche</h3>
                <p class="font-sans text-sm text-stone leading-relaxed mb-4">
                    Interrogation du catalogue par titre, auteur, ISBN, cote ou descripteur thématique.
                </p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Catalogue" asp-action="Search"
                       class="font-sans text-xs font-medium" style="color:#b8952a;">
                        Accéder →
                    </a>
                }
            </div>

            <div class="module-card rounded p-6 fade-up delay-1">
                <div class="module-icon mb-4">
                    <svg width="22" height="22" fill="none" stroke="#b8952a" stroke-width="1.6" viewBox="0 0 24 24">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                    </svg>
                </div>
                <h3 class="font-serif text-lg text-navy mb-2">Exemplaires</h3>
                <p class="font-sans text-sm text-stone leading-relaxed mb-4">
                    Gestion des exemplaires physiques, cotes, localisations et états de conservation.
                </p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Exemplaire" asp-action="Index"
                       class="font-sans text-xs font-medium" style="color:#b8952a;">
                        Accéder →
                    </a>
                }
            </div>

            <div class="module-card rounded p-6 fade-up delay-2">
                <div class="module-icon mb-4">
                    <svg width="22" height="22" fill="none" stroke="#b8952a" stroke-width="1.6" viewBox="0 0 24 24">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <h3 class="font-serif text-lg text-navy mb-2">Auteurs &amp; Éditeurs</h3>
                <p class="font-sans text-sm text-stone leading-relaxed mb-4">
                    Référentiel des auteurs, co-auteurs, éditeurs et organismes responsables des publications.
                </p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Auteur" asp-action="Index"
                       class="font-sans text-xs font-medium" style="color:#b8952a;">
                        Accéder →
                    </a>
                }
            </div>

            <div class="module-card rounded p-6 fade-up delay-3">
                <div class="module-icon mb-4">
                    <svg width="22" height="22" fill="none" stroke="#b8952a" stroke-width="1.6" viewBox="0 0 24 24">
                        <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                        <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                    </svg>
                </div>
                <h3 class="font-serif text-lg text-navy mb-2">Administration</h3>
                <p class="font-sans text-sm text-stone leading-relaxed mb-4">
                    Paramétrage du système, gestion des utilisateurs, thésaurus et tables de référence.
                </p>
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("ADMIN"))
                {
                    <a asp-controller="Admin" asp-action="Index"
                       class="font-sans text-xs font-medium" style="color:#b8952a;">
                        Accéder →
                    </a>
                }
                else
                {
                    <span class="font-sans text-xs text-stone-light">Accès restreint aux administrateurs</span>
                }
            </div>

        </div>
    </section>

    <footer class="border-t border-stone/20 py-8 px-6" style="background:#0f1e35;">
        <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3">
            <p class="font-serif text-sm italic" style="color:rgba(255,255,255,.45);">
                CATLIB_DATA — Système de catalogage bibliographique
            </p>
            <p class="font-sans text-xs" style="color:rgba(255,255,255,.3);">
                &copy; @DateTime.Now.Year — Tous droits réservés
            </p>
        </div>
    </footer>

</div>